                          Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_49/464011432.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     44\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     45\u001b[0m \u001b[0mmodel\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlr_list\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mloss_list\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mtrain_model\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mmodel\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcriterion\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0moptimizer\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mscheduler\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mtrain_loader\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 46\u001b[0;31m \u001b[0mtorch\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0msave\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mmodel\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mstate_dict\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m\"chest_xray_vit.pth\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     47\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     48\u001b[0m \u001b[0;31m# Plot the LR schedule and training loss\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/torch/serialization.py\u001b[0m in \u001b[0;36msave\u001b[0;34m(obj, f, pickle_module, pickle_protocol, _use_new_zipfile_serialization, _disable_byteorder_record)\u001b[0m\n\u001b[1;32m   1001\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1002\u001b[0m     \u001b[0;32mif\u001b[0m \u001b[0m_use_new_zipfile_serialization\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1003\u001b[0;31m         \u001b[0;32mwith\u001b[0m \u001b[0m_open_zipfile_writer\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mf\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;32mas\u001b[0m \u001b[0mopened_zipfile\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   1004\u001b[0m             _save(\n\u001b[1;32m   1005\u001b[0m                 \u001b[0mobj\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/torch/serialization.py\u001b[0m in \u001b[0;36m__exit__\u001b[0;34m(self, *args)\u001b[0m\n\u001b[1;32m    833\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    834\u001b[0m     \u001b[0;32mdef\u001b[0m \u001b[0m__exit__\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m*\u001b[0m\u001b[0margs\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;34m->\u001b[0m \u001b[0;32mNone\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 835\u001b[0;31m         \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mfile_like\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mwrite_end_of_file\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    836\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mfile_stream\u001b[0m \u001b[0;32mis\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0;32mNone\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    837\u001b[0m             \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mfile_stream\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mclose\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mRuntimeError\u001b[0m: [enforce fail at inline_container.cc:672] . unexpected pos 64 vs 0"],"ename":"RuntimeError","evalue":"[enforce fail at inline_container.cc:672] . unexpected pos 64 vs 0","output_type":"error"}],"execution_count":47},{"cell_type":"markdown","source":"**Step 5**:\n\nEvaluating your method. **Please calculate the following metrics and print them: accuracy, precision, recall, and kappa value. In addition, please plot the ROC curve and confusion matrix. (1 point)**\n\nThe following links can help you understand these metrics better.\n\nhttps://www.analyticsvidhya.com/blog/2021/07/metrics-to-evaluate-your-classification-model-to-take-the-right-decisions/\n\nhttps://en.wikipedia.org/wiki/Cohen%27s_kappa\n\nhttps://docs.kolena.com/metrics/cohens-kappa/\n\nhttps://developers.google.com/machine-learning/crash-course/classification/roc-and-auc\n","metadata":{"id":"C2wkuNDDm7RQ"}},{"cell_type":"code","source":"import seaborn as sns\nfrom sklearn.metrics import (confusion_matrix, accuracy_score, precision_score,\n                             recall_score, cohen_kappa_score, roc_curve, auc)\n\n\ndef test_model(model, loader, title=\"\", plot=True):\n    model.eval()\n    all_preds, all_labels, all_probs = [], [], []\n\n    with torch.no_grad():\n        for inputs, labels in loader:\n            inputs = inputs.to(device)\n            outputs = model(inputs)\n            _, preds = torch.max(outputs, 1)\n            probs = torch.softmax(outputs, dim=1)[:, 1]\n\n            all_preds.extend(preds.cpu().numpy())\n            all_probs.extend(probs.cpu().numpy())\n            all_labels.extend(labels.numpy())\n\n    all_preds = np.array(all_preds)\n    all_labels = np.array(all_labels)\n    all_probs = np.array(all_probs)\n\n    # Required metrics\n    accuracy = accuracy_score(all_labels, all_preds)\n    precision = precision_score(all_labels, all_preds)\n    recall = recall_score(all_labels, all_preds)\n    kappa = cohen_kappa_score(all_labels, all_preds)\n\n    # Extra: specificity and error counts (used in Step 6)\n    cm = confusion_matrix(all_labels, all_preds, labels=[0, 1])\n    tn, fp, fn, tp = cm.ravel()\n    specificity = tn / (tn + fp)\n\n    # ROC curve and AUC\n    fpr, tpr, _ = roc_curve(all_labels, all_probs)\n    roc_auc = auc(fpr, tpr)\n\n    print(f\"--- {title} ---\")\n    print(f\"Accuracy: {accuracy:.4f}\")\n    print(f\"Precision: {precision:.4f}\")\n    print(f\"Recall: {recall:.4f}\")\n    print(f\"Specificity: {specificity:.4f}\")\n    print(f\"Cohen Kappa: {kappa:.4f}\")\n    print(f\"AUC: {roc_auc:.4f}\")\n    print(f\"False positives (NORMAL -> PNEUMONIA): {fp}, False negatives: {fn}\")\n\n    if plot:\n        fig, ax = plt.subplots(1, 2, figsize=(12, 5))\n\n        sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", cbar=False,\n                    xticklabels=[\"NORMAL\", \"PNEUMONIA\"],\n                    yticklabels=[\"NORMAL\", \"PNEUMONIA\"], ax=ax[0])\n        ax[0].set_title(f\"Confusion Matrix {title}\")\n        ax[0].set_ylabel(\"True Label\")\n        ax[0].set_xlabel(\"Predicted Label\")\n\n        ax[1].plot(fpr, tpr, label=f\"ROC (AUC = {roc_auc:.4f})\")\n        ax[1].plot([0, 1], [0, 1], linestyle=\"--\", label=\"Random guess\")\n        ax[1].set_title(f\"ROC Curve {title}\")\n        ax[1].set_xlabel(\"False Positive Rate\")\n        ax[1].set_ylabel(\"True Positive Rate\")\n        ax[1].legend(loc=\"lower right\")\n\n        plt.tight_layout()\n        plt.show()\n\n    return {\"Accuracy\": accuracy, \"Precision\": precision, \"Recall\": recall,\n            \"Specificity\": specificity, \"Kappa\": kappa, \"AUC\": roc_auc,\n            \"FP\": int(fp), \"FN\": int(fn)}\n\n\nmodel.load_state_dict(torch.load(\"chest_xray_vit.pth\"))\nbaseline_metrics = test_model(model, test_loader, title=\"(Baseline, test set)\")\n\n# Training-set evaluation (no augmentation, no shuffling), used in Step 6\ntrain_eval_loader = DataLoader(train_dataset, batch_size=32, shuffle=False, num_workers=2)\nbaseline_train_metrics = test_model(model, train_eval_loader, title=\"(Baseline, train set)\", plot=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T18:08:30.181676Z","iopub.execute_input":"2026-10-11T18:08:30.181977Z","iopub.status.idle":"2026-10-11T18:08:30.204999Z","shell.execute_reply.started":"2026-10-11T18:08:30.181952Z","shell.execute_reply":"2026-10-11T18:08:30.203933Z"}},"outputs":[{"name":"stdout","text":"The history saving thread hit an unexpected error (OperationalError('attempt to write a readonly database')).History will not be written to the database.\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mEOFError\u001b[0m                                  Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_49/2632558042.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     72\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     73\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 74\u001b[0;31m \u001b[0mmodel\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload_state_dict\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mtorch\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m\"chest_xray_vit.pth\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     75\u001b[0m \u001b[0mbaseline_metrics\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mtest_model\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mmodel\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mtest_loader\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mtitle\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m\"(Baseline, test set)\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     76\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/torch/serialization.py\u001b[0m in \u001b[0;36mload\u001b[0;34m(f, map_location, pickle_module, weights_only, mmap, **pickle_load_args)\u001b[0m\n\u001b[1;32m   1593\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0mweights_only\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1594\u001b[0m             \u001b[0;32mtry\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1595\u001b[0;31m                 return _legacy_load(\n\u001b[0m\u001b[1;32m   1596\u001b[0m                     \u001b[0mopened_file\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1597\u001b[0m                     \u001b[0mmap_location\u001b[0m\u001b[0;34m,\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/torch/serialization.py\u001b[0m in \u001b[0;36m_legacy_load\u001b[0;34m(f, map_location, pickle_module, **pickle_load_args)\u001b[0m\n\u001b[1;32m   1853\u001b[0m             \u001b[0mf\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mseek\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m0\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1854\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1855\u001b[0;31m     \u001b[0mmagic_number\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mpickle_module\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mf\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m**\u001b[0m\u001b[0mpickle_load_args\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   1856\u001b[0m     \u001b[0;32mif\u001b[0m \u001b[0mmagic_number\u001b[0m \u001b[0;34m!=\u001b[0m \u001b[0mMAGIC_NUMBER\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1857\u001b[0m         \u001b[0;32mraise\u001b[0m \u001b[0mRuntimeError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m\"Invalid magic number; corrupt file?\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/torch/_weights_only_unpickler.py\u001b[0m in \u001b[0;36mload\u001b[0;34m(file, encoding)\u001b[0m\n\u001b[1;32m    588\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    589\u001b[0m \u001b[0;32mdef\u001b[0m \u001b[0mload\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mfile\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m*\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mencoding\u001b[0m\u001b[0;34m:\u001b[0m \u001b[0mstr\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0;34m\"ASCII\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 590\u001b[0;31m     \u001b[0;32mreturn\u001b[0m \u001b[0mUnpickler\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mfile\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mencoding\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0mencoding\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/torch/_weights_only_unpickler.py\u001b[0m in \u001b[0;36mload\u001b[0;34m(self)\u001b[0m\n\u001b[1;32m    325\u001b[0m             \u001b[0mkey\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mread\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m1\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    326\u001b[0m             \u001b[0;32mif\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0mkey\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 327\u001b[0;31m                 \u001b[0;32mraise\u001b[0m \u001b[0mEOFError\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    328\u001b[0m             \u001b[0;32mif\u001b[0m \u001b[0;32mnot\u001b[0m \u001b[0misinstance\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mkey\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mbytes_types\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    329\u001b[0m                 \u001b[0;32mraise\u001b[0m \u001b[0mAssertionError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34mf\"Expected bytes, got {type(key).__name__}\"\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mEOFError\u001b[0m: "],"ename":"EOFError","evalue":"","output_type":"error"}],"execution_count":48},{"cell_type":"code","source":"print(baseline_train_metrics)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-03T11:02:41.358468Z","iopub.execute_input":"2026-10-03T11:02:41.358778Z","iopub.status.idle":"2026-10-03T11:02:41.373294Z","shell.execute_reply.started":"2026-10-03T11:02:41.358756Z","shell.execute_reply":"2026-10-03T11:02:41.372384Z"}},"outputs":[{"name":"stdout","text":"{'Accuracy': 0.9093174846625767, 'Precision': 0.9786156443444006, 'Recall': 0.8975483870967742, 'Specificity': np.float64(0.9433258762117822), 'Kappa': np.float64(0.7798383104155892), 'AUC': np.float64(0.972333020615333), 'FP': 76, 'FN': 397}\n","output_type":"stream"}],"execution_count":13},{"cell_type":"markdown","source":"**Step 6: Optimization Research Experiment (6 points)**\n\nUsing the final ViT from Steps 1–5 as the baseline, with its selected hyperparameters fixed, identify **one meaningful improvement opportunity**, analyze its possible cause, and design an experiment to address it.\n\n**Important:** Use the best hyperparameter settings obtained from Steps 1–5 and keep them fixed throughout this experiment. Hyperparameter tuning itself should not be considered an intervention.\n\n1. **Baseline diagnosis (1 point)**: Identify a specific issue in the baseline results and propose a possible cause.\n\n2. **Experiment design (1 point)**: Propose one intervention based on the cause. Change **one** main factor at a time while keeping the other important settings controlled.\n\n3. **Experiment (2 points)**: Implement the proposed experiment in code, run all the experiment including evaluation, and also save all required outputs and results in the notebook.\n\n4. **Analysis and Interpretation (2 points)**: Compare the modified model with the baseline using relevant evaluation metrics, and determine whether the intervention copes with the identified issue\n\n**Possible interventions** include, but are **not limited to**, modifying the loss function, class-imbalance handling (e.g., class-balanced sampling), data augmentation, representation aggregation (e.g., mean pooling instead of CLS-token pooling), or model architecture improvement.\n\n**Example:**\n1. **Baseline diagnosis**: The Baseline model achieves high recall but relatively low precision because many normal images are misclassified as pneumonia. One possible cause is that the current loss does not sufficiently focus on hard-to-classify normal samples.\n3. **Experiment design**: The experiment could replace weighted cross-entropy with Focal Loss while keeping all other settings unchanged.\n4. **Experiment**: ...... (Experiment code and results)\n5. **Analysis and Interpretation**: Precision Score with the modified model is..., while that of baseline is..., which indicates...","metadata":{"id":"F98nLhcLr1Qa"}},{"cell_type":"markdown","source":"1. **Baseline diagnosis**:\n\nThe baseline ViT (weighted cross-entropy, Adam, cosine LR decay, 15 epochs, no augmentation) is\nstrongly biased towards predicting PNEUMONIA , with a Recall of 0.923 (30 of 390 pneumonia cases missed),\nSpecificity of 0.624 (88 of 234 normal X-rays flagged as pneumonia) \n\nThe main weakness is recognising NORMAL X-rays: 38% of healthy patients are misclassified, which\nlowers precision and Kappa and would cause many unnecessary follow-ups in practice.\n\nPossible cause: overfitting and poor generalisation. The model reaches 0,9accuracy on\nthe training set but 0.811 on the test set. A Vision Transformer trained from scratch has weak\nbuilt-in assumptions about images (unlike a CNN) and typically needs very large datasets; with only\nabout 5,200 training images, it can memorise scan-specific details such as exact positioning,\nbrightness and contrast instead of learning features of the disease. The NORMAL class is the minority\n(1,341 vs 3,875 images), so its features are learned from the least data and are the first to fail on\nunseen test images, which then default to the majority PNEUMONIA class.","metadata":{"id":"QHDRSfdkjS80"}},{"cell_type":"markdown","source":"# Experiment 1(Data Augmentation)","metadata":{}},{"cell_type":"markdown","source":"2. **Experiment design(data augmentation)**:\n\nApplied random data augmentation to the training images only. Each time a training\nimage is loaded, it receives a small random transformation that keeps its label unchanged:\n- `RandomAffine`: rotation up to ±10°, translation up to 5%, scaling between 0.9 and 1.1, simulating\n  differences in patient positioning;\n- `ColorJitter`: brightness and contrast changes of up to ±20%, simulating differences between scanners\n  and exposure settings.\n\nHorizontal flipping is deliberately excluded, because it would place the heart on the wrong side of\nthe chest, which never occurs in real X-rays.\n\nThis could address the cause as the model sees a different random version of each image in\nevery epoch, it cannot memorise exact scans or rely on shortcuts such as overall brightness or\nposition. It is pushed to learn features that remain consistent under these variations, such as the\ntexture of lung opacities, which should generalise better to unseen patients.\n\nControlled setup: everything else is identical to the baseline: the same ViT architecture and size,\nweighted cross-entropy loss ([1.0, 0.4]), Adam with LR 1e-4, cosine LR decay, 15 epochs, batch size 16,\nand the same unaugmented test set and evaluation code. The only changed factor is the training-data\naugmentation.\n\nHypothesis: if overfitting causes the misclassified NORMAL images, augmentation should increase\nspecificity and precision and reduce the train-test gap, ideally without a large drop in recall.","metadata":{"id":"0zHeGnzZjTuS"}},{"cell_type":"markdown","source":"3. **Experiment**:","metadata":{"id":"KoevMkAxkKAs"}},{"cell_type":"code","source":"import random\n\ndef set_seed(seed=42):\n    random.seed(seed\n               \n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.deterministic = True\n    torch.backends.cudnn.benchmark = False","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-29T06:09:20.761214Z","iopub.execute_input":"2026-09-29T06:09:20.761515Z","iopub.status.idle":"2026-09-29T06:09:20.767243Z","shell.execute_reply.started":"2026-09-29T06:09:20.761492Z","shell.execute_reply":"2026-09-29T06:09:20.766382Z"}},"outputs":[],"execution_count":25},{"cell_type":"code","source":"\n# EXPERIMENT: training-set data augmentation\n\naug_transforms = transforms.Compose([\n    transforms.Resize((224, 224)),\n    transforms.Grayscale(num_output_channels=3),\n    transforms.RandomAffine(degrees=10, translate=(0.05, 0.05), scale=(0.9, 1.1)),\n    transforms.ColorJitter(brightness=0.2, contrast=0.2),\n    transforms.ToTensor(),\n])\n\ntrain_dataset_aug = ChestXRayDataset(root_dir=train_dir, transform=aug_transforms)\ntrain_loader_aug = DataLoader(train_dataset_aug, batch_size=16, shuffle=True, num_workers=2)\n\n# Show a few augmented samples as a sanity check\nfig, axes = plt.subplots(1, 5, figsize=(15, 3))\nfor i, ax in enumerate(axes):\n    img, label = train_dataset_aug[i * 300]\n    ax.imshow(img.permute(1, 2, 0))\n    ax.set_title(\"NORMAL\" if label == 0 else \"PNEUMONIA\")\n    ax.axis(\"off\")\nplt.suptitle(\"Augmented training samples\")\nplt.show()\n\n# Identical model, loss, optimiser, scheduler and epochs as the baseline\nset_seed(42)\nmodel_aug = VisionTransformer(224, 16, 3, 384, 8, 8, 2, 1024).to(device)\ncriterion_aug = nn.CrossEntropyLoss(weight=torch.tensor([1.0, 0.4], device=device)).to(device)\noptimizer_aug = optim.Adam(model_aug.parameters(), lr=1e-4)\nscheduler_aug = optim.lr_scheduler.CosineAnnealingLR(optimizer_aug, T_max=NUM_EPOCHS, eta_min=1e-6)\n\nmodel_aug, lr_list_aug, loss_list_aug = train_model(\n    model_aug, criterion_aug, optimizer_aug, scheduler_aug, train_loader_aug\n)\ntorch.save(model_aug.state_dict(), \"chest_xray_vit_aug.pth\")","metadata":{"id":"CdxzIOK9r1Qb","trusted":true,"execution":{"iopub.status.busy":"2026-09-29T06:09:26.718354Z","iopub.execute_input":"2026-09-29T06:09:26.719092Z","iopub.status.idle":"2026-09-29T06:23:42.804692Z","shell.execute_reply.started":"2026-09-29T06:09:26.719061Z","shell.execute_reply":"2026-09-29T06:23:42.803638Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x300 with 5 Axes>","image/png":"\n"},"metadata":{}},{"name":"stderr","text":"Epoch 1/15: 100%|██████████| 326/326 [00:55<00:00,  5.84it/s, loss=0.733]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 1: avg loss = 0.7333, lr = 1.00e-04\n","output_type":"stream"},{"name":"stderr","text":"Epoch 2/15: 100%|██████████| 326/326 [00:54<00:00,  5.95it/s, loss=0.703]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 2: avg loss = 0.6982, lr = 9.89e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 3/15: 100%|██████████| 326/326 [00:55<00:00,  5.91it/s, loss=0.713]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 3: avg loss = 0.6919, lr = 9.57e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 4/15: 100%|██████████| 326/326 [00:55<00:00,  5.88it/s, loss=0.7]  \n","output_type":"stream"},{"name":"stdout","text":"Epoch 4: avg loss = 0.6925, lr = 9.05e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 5/15: 100%|██████████| 326/326 [00:56<00:00,  5.80it/s, loss=0.694]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 5: avg loss = 0.6901, lr = 8.36e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 6/15: 100%|██████████| 326/326 [00:55<00:00,  5.83it/s, loss=0.712]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 6: avg loss = 0.6897, lr = 7.52e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 7/15: 100%|██████████| 326/326 [00:56<00:00,  5.77it/s, loss=0.707]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 7: avg loss = 0.6813, lr = 6.58e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 8/15: 100%|██████████| 326/326 [01:04<00:00,  5.07it/s, loss=0.606]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 8: avg loss = 0.6832, lr = 5.57e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 9/15: 100%|██████████| 326/326 [00:58<00:00,  5.56it/s, loss=0.597]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 9: avg loss = 0.6451, lr = 4.53e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 10/15: 100%|██████████| 326/326 [00:56<00:00,  5.77it/s, loss=0.453]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 10: avg loss = 0.6103, lr = 3.52e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 11/15: 100%|██████████| 326/326 [00:56<00:00,  5.80it/s, loss=0.631]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 11: avg loss = 0.5677, lr = 2.58e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 12/15: 100%|██████████| 326/326 [00:57<00:00,  5.65it/s, loss=0.344]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 12: avg loss = 0.4656, lr = 1.74e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 13/15: 100%|██████████| 326/326 [00:56<00:00,  5.72it/s, loss=0.165]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 13: avg loss = 0.4173, lr = 1.05e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 14/15: 100%|██████████| 326/326 [00:58<00:00,  5.61it/s, loss=0.34] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 14: avg loss = 0.3840, lr = 5.28e-06\n","output_type":"stream"},{"name":"stderr","text":"Epoch 15/15: 100%|██████████| 326/326 [00:57<00:00,  5.69it/s, loss=0.178]","output_type":"stream"},{"name":"stdout","text":"Epoch 15: avg loss = 0.3673, lr = 2.08e-06\nLR per epoch: ['1.00e-04', '9.89e-05', '9.57e-05', '9.05e-05', '8.36e-05', '7.52e-05', '6.58e-05', '5.57e-05', '4.53e-05', '3.52e-05', '2.58e-05', '1.74e-05', '1.05e-05', '5.28e-06', '2.08e-06']\n","output_type":"stream"},{"name":"stderr","text":"\n","output_type":"stream"}],"execution_count":26},{"cell_type":"markdown","source":"4. **Analysis and Interpretation**:","metadata":{"id":"hp1t1dvxjUEL"}},{"cell_type":"code","source":"# ============================================================\n# Evaluate the augmented model with the same code and test set\n# ============================================================\naug_metrics = test_model(model_aug, test_loader, title=\"(Augmented, test set)\")\naug_train_metrics = test_model(model_aug, train_eval_loader, title=\"(Augmented, train set)\", plot=False)\n\n# Side-by-side comparison on the test set\ncomparison = pd.DataFrame({\"Baseline\": baseline_metrics, \"Augmented\": aug_metrics}).T\ncomparison.loc[\"Change\"] = comparison.loc[\"Augmented\"] - comparison.loc[\"Baseline\"]\nprint(\"\\nTest-set comparison:\")\ndisplay(comparison.round(4))\n\n# Train vs test gap (a measure of overfitting)\ngap = pd.DataFrame({\n    \"Train accuracy\": [baseline_train_metrics[\"Accuracy\"], aug_train_metrics[\"Accuracy\"]],\n    \"Test accuracy\": [baseline_metrics[\"Accuracy\"], aug_metrics[\"Accuracy\"]],\n}, index=[\"Baseline\", \"Augmented\"])\ngap[\"Gap\"] = gap[\"Train accuracy\"] - gap[\"Test accuracy\"]\nprint(\"\\nTrain vs test accuracy gap:\")\ndisplay(gap.round(4))\n\n# Training loss curves\nplt.figure(figsize=(6, 4))\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list, marker=\"o\", label=\"Baseline\")\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list_aug, marker=\"o\", label=\"Augmented\")\nplt.xlabel(\"Epoch\")\nplt.ylabel(\"Average training loss\")\nplt.title(\"Training loss: baseline vs augmented\")\nplt.legend()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-29T06:23:46.603256Z","iopub.execute_input":"2026-09-29T06:23:46.603989Z","iopub.status.idle":"2026-09-29T06:24:41.57976Z","shell.execute_reply.started":"2026-09-29T06:23:46.603951Z","shell.execute_reply":"2026-09-29T06:24:41.578899Z"}},"outputs":[{"name":"stdout","text":"--- (Augmented, test set) ---\nAccuracy: 0.7981\nPrecision: 0.8455\nRecall: 0.8282\nSpecificity: 0.7479\nCohen Kappa: 0.5722\nAUC: 0.8906\nFalse positives (NORMAL -> PNEUMONIA): 59, False negatives: 67\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"--- (Augmented, train set) ---\nAccuracy: 0.8439\nPrecision: 0.9500\nRecall: 0.8338\nSpecificity: 0.8732\nCohen Kappa: 0.6338\nAUC: 0.9241\nFalse positives (NORMAL -> PNEUMONIA): 170, False negatives: 644\n\nTest-set comparison:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"           Accuracy  Precision  Recall  Specificity   Kappa     AUC    FP  \\\nBaseline     0.8109     0.8036  0.9231       0.6239  0.5755  0.8723  88.0   \nAugmented    0.7981     0.8455  0.8282       0.7479  0.5722  0.8906  59.0   \nChange      -0.0128     0.0420 -0.0949       0.1239 -0.0034  0.0183 -29.0   \n\n             FN  \nBaseline   30.0  \nAugmented  67.0  \nChange     37.0  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Accuracy</th>\n      <th>Precision</th>\n      <th>Recall</th>\n      <th>Specificity</th>\n      <th>Kappa</th>\n      <th>AUC</th>\n      <th>FP</th>\n      <th>FN</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Baseline</th>\n      <td>0.8109</td>\n      <td>0.8036</td>\n      <td>0.9231</td>\n      <td>0.6239</td>\n      <td>0.5755</td>\n      <td>0.8723</td>\n      <td>88.0</td>\n      <td>30.0</td>\n    </tr>\n    <tr>\n      <th>Augmented</th>\n      <td>0.7981</td>\n      <td>0.8455</td>\n      <td>0.8282</td>\n      <td>0.7479</td>\n      <td>0.5722</td>\n      <td>0.8906</td>\n      <td>59.0</td>\n      <td>67.0</td>\n    </tr>\n    <tr>\n      <th>Change</th>\n      <td>-0.0128</td>\n      <td>0.0420</td>\n      <td>-0.0949</td>\n      <td>0.1239</td>\n      <td>-0.0034</td>\n      <td>0.0183</td>\n      <td>-29.0</td>\n      <td>37.0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nTrain vs test accuracy gap:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"           Train accuracy  Test accuracy     Gap\nBaseline           0.9080         0.8109  0.0971\nAugmented          0.8439         0.7981  0.0459","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Train accuracy</th>\n      <th>Test accuracy</th>\n      <th>Gap</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Baseline</th>\n      <td>0.9080</td>\n      <td>0.8109</td>\n      <td>0.0971</td>\n    </tr>\n    <tr>\n      <th>Augmented</th>\n      <td>0.8439</td>\n      <td>0.7981</td>\n      <td>0.0459</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":27},{"cell_type":"markdown","source":"Augmentation addressed the problem targeted partially.\n\n*Normal X-rays*:specificity rose from 0.624 to 0.748. False positives (healthy patients flagged as pneumonia) fell from 88 to 59, and precision improved from 0.804 to 0.846.\nOverfitting: the train–test accuracy gap halved, from 0.097 to 0.046. The model is no longer memorising scan-specific details.\n*Ranking*: AUC rose slightly, from 0.872 to 0.891.\n\nHowever, the improvement came at a cost:\n\nRecall dropped from 0.923 to 0.828, and missed pneumonia cases more than doubled (30 → 67).\nTotal errors went up (118 → 126), so accuracy fell slightly (0.811 → 0.798) and Kappa was unchanged (0.576 → 0.572).\n\nThe training curve explains why. With augmentation, the training loss stayed near 0.69 for the first eight epochs. That is the loss of a model guessing at random, so the model learned almost nothing at first. It only began improving in the second half of training and finished at 0.367, compared with 0.210 for the baseline. Training accuracy also fell, from 0.908 to 0.844.\n\nSo the smaller gap does not mean the model learned better features. It means the model learned less overall, and its training performance dropped towards its test performance. Once the model could no longer memorise exact images, the varied inputs exposed how weak its feature extraction was.\n\nThe intervention partly copes with the identified issue. It reduced overfitting and the NORMAL misclassifications, but it traded false positives for false negatives rather than reducing total errors. This suggests overfitting was a symptom rather than the root cause. The real limitation is that the model cannot extract strong enough features from the X-rays, which is what I target in the next experiments.","metadata":{}},{"cell_type":"markdown","source":"# **Experiment 2(positional embeddings)**","metadata":{}},{"cell_type":"markdown","source":"Augmentation addressed the original issue: specificity rose from 0.624 to 0.748 and false positives\nfell by a third. However, recall dropped from 0.923 to 0.828, and missed pneumonia cases more than\ndoubled. Kappa and accuracy were essentially unchanged, so at the default 0.5 threshold the model\ntraded one kind of error for another rather than reducing total errors.\n\nThe remaining issue is that the model's overall ability to separate the two classes is still limited:\nAUC improved only to 0.891. A better representation, not just a different balance of errors, is needed\nto improve both recall and specificity together.\n\nPossible cause: the model has no positional embeddings, which were removed from the template. Self-\nattention on its own treats the 196 patches as an unordered set, so the model cannot tell which part\nof the chest a patch comes from: left or right lung, upper or lower zone, lung tissue or image border.\nIn chest X-rays, location is clinically meaningful. Pneumonia typically appears as opacity within\nspecific lung regions, while bright areas near the edges or over the heart and spine are normal\nanatomy. Without position information, a hazy patch over the heart and a hazy patch in the lower lung\nlook identical to the model, which limits how well it can separate NORMAL from PNEUMONIA.\n\nDeeper models or different optimisers were not chosen,because more layers would add capacity that a 5,200-image dataset cannot support (worsening overfitting), and optimiser changes count as hyperparameter tuning. Positional embeddings target aspecific, identifiable gap in the architecture, are the standard ViT design, and add a single\ncomponent that can be isolated in a controlled comparison.","metadata":{}},{"cell_type":"markdown","source":"**Experiment design**\n\nAdded a learnable positional embedding to the ViT. This is a table of 197 × 384 learnable\nnumbers, one 384-number vector for each token position (196 patches plus the CLS token). After the CLS\ntoken is attached, each token's vector is added to its position's vector, so every token carries\ninformation about where in the image it came from. The embedding is initialised with small random\nvalues (truncated normal, standard deviation 0.02), following the standard ViT design, and is learned\nduring training like any other weight.\n\nWith position information, attention can learn location-dependent\nrelationships, for example that opacity in the lower lung zones is suspicious while brightness over\nthe heart is normal. This should improve the model's ability to separate the two classes, reflected\nmainly in a higher AUC and ideally a recovery in recall without losing the specificity gained from\naugmentation.\n\nControlled setup: this experiment is compared against the augmented model from Experiment 1. Everything\nelse is identical: the same augmentation, architecture size, weight-initialisation seed (42), weighted\ncross-entropy loss, Adam with LR 1e-4, cosine LR decay, 15 epochs, batch size 16, and the same test set\nand evaluation code. The positional embedding is created after all the original layers, so every\nshared weight starts from the same values as in the augmented model. The only changed factor is the\npositional embedding.\n\nHypothesis: if missing spatial information limits class separation, adding positional embeddings\nshould increase AUC and improve the balance between recall and specificity. Because 197 × 384 new\nparameters must be learned from limited data within 15 epochs, a small or no improvement is also\npossible, and would suggest that spatial information is not the main bottleneck at this training budget.","metadata":{}},{"cell_type":"code","source":"class VisionTransformerPos(VisionTransformer):\n    def __init__(self, image_size, patch_size, in_channels, embed_dim, num_heads,\n                 num_layers, num_classes, feedforward_dim=2048, dropout=0.1):\n        # Build the exact same ViT as before (same seed -> same starting weights)\n        super().__init__(image_size, patch_size, in_channels, embed_dim, num_heads,\n                         num_layers, num_classes, feedforward_dim, dropout)\n\n        # NEW: one learnable 384-number vector per position (196 patches + 1 CLS)\n        num_tokens = self.patch_embedding.num_patches + 1\n        self.pos_embed = nn.Parameter(torch.zeros(1, num_tokens, embed_dim))\n        nn.init.trunc_normal_(self.pos_embed, std=0.02)   # standard ViT initialisation\n\n    def forward(self, x):\n        x = self.patch_embedding(x)                       # [B, 196, D]\n        B = x.shape[0]\n        cls_tokens = self.cls_token.expand(B, -1, -1)     # [B, 1, D]\n        x = torch.cat((cls_tokens, x), dim=1)             # [B, 197, D]\n\n        x = x + self.pos_embed                            # NEW: add position information\n\n        for encoder_layer in self.encoder_layers:\n            x = encoder_layer(x)\n\n        cls_output = x[:, 0]\n        return self.mlp_head(cls_output)\n\n\n# Identical settings to the augmented model\nset_seed(42)\nmodel_pos = VisionTransformerPos(224, 16, 3, 384, 8, 8, 2, 1024).to(device)\ncriterion_pos = nn.CrossEntropyLoss(weight=torch.tensor([1.0, 0.4], device=device)).to(device)\noptimizer_pos = optim.Adam(model_pos.parameters(), lr=1e-4)\nscheduler_pos = optim.lr_scheduler.CosineAnnealingLR(optimizer_pos, T_max=NUM_EPOCHS, eta_min=1e-6)\n\nmodel_pos, lr_list_pos, loss_list_pos = train_model(\n    model_pos, criterion_pos, optimizer_pos, scheduler_pos, train_loader_aug   # same augmented data\n)\ntorch.save(model_pos.state_dict(), \"chest_xray_vit_aug_pos.pth\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-29T06:32:00.04401Z","iopub.execute_input":"2026-09-29T06:32:00.044891Z","iopub.status.idle":"2026-09-29T06:46:00.205322Z","shell.execute_reply.started":"2026-09-29T06:32:00.044851Z","shell.execute_reply":"2026-09-29T06:46:00.204342Z"}},"outputs":[{"name":"stderr","text":"Epoch 1/15: 100%|██████████| 326/326 [00:55<00:00,  5.88it/s, loss=0.698]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 1: avg loss = 0.7325, lr = 1.00e-04\n","output_type":"stream"},{"name":"stderr","text":"Epoch 2/15: 100%|██████████| 326/326 [00:55<00:00,  5.92it/s, loss=0.703]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 2: avg loss = 0.7016, lr = 9.89e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 3/15: 100%|██████████| 326/326 [00:55<00:00,  5.87it/s, loss=0.665]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 3: avg loss = 0.6926, lr = 9.57e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 4/15: 100%|██████████| 326/326 [00:55<00:00,  5.92it/s, loss=0.753]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 4: avg loss = 0.6916, lr = 9.05e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 5/15: 100%|██████████| 326/326 [00:54<00:00,  5.99it/s, loss=0.75] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 5: avg loss = 0.6897, lr = 8.36e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 6/15: 100%|██████████| 326/326 [00:55<00:00,  5.85it/s, loss=0.71] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 6: avg loss = 0.6923, lr = 7.52e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 7/15: 100%|██████████| 326/326 [00:56<00:00,  5.77it/s, loss=0.688]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 7: avg loss = 0.6901, lr = 6.58e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 8/15: 100%|██████████| 326/326 [00:56<00:00,  5.81it/s, loss=0.686]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 8: avg loss = 0.6892, lr = 5.57e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 9/15: 100%|██████████| 326/326 [00:58<00:00,  5.53it/s, loss=0.683]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 9: avg loss = 0.6863, lr = 4.53e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 10/15: 100%|██████████| 326/326 [00:58<00:00,  5.61it/s, loss=0.633]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 10: avg loss = 0.6814, lr = 3.52e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 11/15: 100%|██████████| 326/326 [00:59<00:00,  5.49it/s, loss=0.733]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 11: avg loss = 0.6327, lr = 2.58e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 12/15: 100%|██████████| 326/326 [00:54<00:00,  5.95it/s, loss=0.433]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 12: avg loss = 0.6063, lr = 1.74e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 13/15: 100%|██████████| 326/326 [00:55<00:00,  5.85it/s, loss=0.264]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 13: avg loss = 0.5257, lr = 1.05e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 14/15: 100%|██████████| 326/326 [00:54<00:00,  5.97it/s, loss=0.495]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 14: avg loss = 0.4409, lr = 5.28e-06\n","output_type":"stream"},{"name":"stderr","text":"Epoch 15/15: 100%|██████████| 326/326 [00:54<00:00,  5.98it/s, loss=0.413]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 15: avg loss = 0.4126, lr = 2.08e-06\nLR per epoch: ['1.00e-04', '9.89e-05', '9.57e-05', '9.05e-05', '8.36e-05', '7.52e-05', '6.58e-05', '5.57e-05', '4.53e-05', '3.52e-05', '2.58e-05', '1.74e-05', '1.05e-05', '5.28e-06', '2.08e-06']\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"# ============================================================\n# Evaluate and compare: Baseline vs Augmented vs Augmented + Positional\n# ============================================================\npos_metrics = test_model(model_pos, test_loader, title=\"(Augmented + Positional, test set)\")\npos_train_metrics = test_model(model_pos, train_eval_loader,\n                               title=\"(Augmented + Positional, train set)\", plot=False)\n\ncomparison_all = pd.DataFrame({\n    \"Baseline\": baseline_metrics,\n    \"Augmented\": aug_metrics,\n    \"Aug + Positional\": pos_metrics,\n}).T\ncomparison_all.loc[\"Change (Pos vs Aug)\"] = (\n    comparison_all.loc[\"Aug + Positional\"] - comparison_all.loc[\"Augmented\"]\n)\nprint(\"\\nTest-set comparison:\")\ndisplay(comparison_all.round(4))\n\ngap_all = pd.DataFrame({\n    \"Train accuracy\": [baseline_train_metrics[\"Accuracy\"], aug_train_metrics[\"Accuracy\"],\n                       pos_train_metrics[\"Accuracy\"]],\n    \"Test accuracy\": [baseline_metrics[\"Accuracy\"], aug_metrics[\"Accuracy\"],\n                      pos_metrics[\"Accuracy\"]],\n}, index=[\"Baseline\", \"Augmented\", \"Aug + Positional\"])\ngap_all[\"Gap\"] = gap_all[\"Train accuracy\"] - gap_all[\"Test accuracy\"]\nprint(\"\\nTrain vs test accuracy gap:\")\ndisplay(gap_all.round(4))\n\nplt.figure(figsize=(6, 4))\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list, marker=\"o\", label=\"Baseline\")\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list_aug, marker=\"o\", label=\"Augmented\")\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list_pos, marker=\"o\", label=\"Aug + Positional\")\nplt.xlabel(\"Epoch\")\nplt.ylabel(\"Average training loss\")\nplt.title(\"Training loss comparison\")\nplt.legend()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-29T06:46:22.769306Z","iopub.execute_input":"2026-09-29T06:46:22.770228Z","iopub.status.idle":"2026-09-29T06:47:15.44521Z","shell.execute_reply.started":"2026-09-29T06:46:22.770179Z","shell.execute_reply":"2026-09-29T06:47:15.44432Z"}},"outputs":[{"name":"stdout","text":"--- (Augmented + Positional, test set) ---\nAccuracy: 0.7869\nPrecision: 0.8373\nRecall: 0.8179\nSpecificity: 0.7350\nCohen Kappa: 0.5488\nAUC: 0.8794\nFalse positives (NORMAL -> PNEUMONIA): 62, False negatives: 71\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"--- (Augmented + Positional, train set) ---\nAccuracy: 0.8499\nPrecision: 0.9479\nRecall: 0.8444\nSpecificity: 0.8658\nCohen Kappa: 0.6438\nAUC: 0.9203\nFalse positives (NORMAL -> PNEUMONIA): 180, False negatives: 603\n\nTest-set comparison:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                     Accuracy  Precision  Recall  Specificity   Kappa     AUC  \\\nBaseline               0.8109     0.8036  0.9231       0.6239  0.5755  0.8723   \nAugmented              0.7981     0.8455  0.8282       0.7479  0.5722  0.8906   \nAug + Positional       0.7869     0.8373  0.8179       0.7350  0.5488  0.8794   \nChange (Pos vs Aug)   -0.0112    -0.0083 -0.0103      -0.0128 -0.0234 -0.0112   \n\n                       FP    FN  \nBaseline             88.0  30.0  \nAugmented            59.0  67.0  \nAug + Positional     62.0  71.0  \nChange (Pos vs Aug)   3.0   4.0  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Accuracy</th>\n      <th>Precision</th>\n      <th>Recall</th>\n      <th>Specificity</th>\n      <th>Kappa</th>\n      <th>AUC</th>\n      <th>FP</th>\n      <th>FN</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Baseline</th>\n      <td>0.8109</td>\n      <td>0.8036</td>\n      <td>0.9231</td>\n      <td>0.6239</td>\n      <td>0.5755</td>\n      <td>0.8723</td>\n      <td>88.0</td>\n      <td>30.0</td>\n    </tr>\n    <tr>\n      <th>Augmented</th>\n      <td>0.7981</td>\n      <td>0.8455</td>\n      <td>0.8282</td>\n      <td>0.7479</td>\n      <td>0.5722</td>\n      <td>0.8906</td>\n      <td>59.0</td>\n      <td>67.0</td>\n    </tr>\n    <tr>\n      <th>Aug + Positional</th>\n      <td>0.7869</td>\n      <td>0.8373</td>\n      <td>0.8179</td>\n      <td>0.7350</td>\n      <td>0.5488</td>\n      <td>0.8794</td>\n      <td>62.0</td>\n      <td>71.0</td>\n    </tr>\n    <tr>\n      <th>Change (Pos vs Aug)</th>\n      <td>-0.0112</td>\n      <td>-0.0083</td>\n      <td>-0.0103</td>\n      <td>-0.0128</td>\n      <td>-0.0234</td>\n      <td>-0.0112</td>\n      <td>3.0</td>\n      <td>4.0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nTrain vs test accuracy gap:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                  Train accuracy  Test accuracy     Gap\nBaseline                  0.9080         0.8109  0.0971\nAugmented                 0.8439         0.7981  0.0459\nAug + Positional          0.8499         0.7869  0.0630","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Train accuracy</th>\n      <th>Test accuracy</th>\n      <th>Gap</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Baseline</th>\n      <td>0.9080</td>\n      <td>0.8109</td>\n      <td>0.0971</td>\n    </tr>\n    <tr>\n      <th>Augmented</th>\n      <td>0.8439</td>\n      <td>0.7981</td>\n      <td>0.0459</td>\n    </tr>\n    <tr>\n      <th>Aug + Positional</th>\n      <td>0.8499</td>\n      <td>0.7869</td>\n      <td>0.0630</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 600x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":29},{"cell_type":"code","source":"# ============================================================\n# EXPERIMENT 3: augmentation + convolutional stem\n# Only change vs the augmented model: the patch-embedding module.\n# ============================================================\n\nclass ConvStemEmbedding(nn.Module):\n    def __init__(self, in_channels=3, embed_dim=384):\n        super().__init__()\n        channels = [in_channels, 48, 96, 192, 384]\n        layers = []\n        for c_in, c_out in zip(channels[:-1], channels[1:]):\n            layers += [\n                nn.Conv2d(c_in, c_out, kernel_size=3, stride=2, padding=1, bias=False),\n                nn.BatchNorm2d(c_out),\n                nn.ReLU(inplace=True),\n            ]\n        layers.append(nn.Conv2d(channels[-1], embed_dim, kernel_size=1))   # final 1x1 projection\n        self.stem = nn.Sequential(*layers)\n        self.num_patches = 14 * 14\n\n    def forward(self, x):\n        x = self.stem(x)        # [B, 384, 14, 14]\n        x = x.flatten(2)        # [B, 384, 196]\n        x = x.transpose(1, 2)   # [B, 196, 384]\n        return x\n\n\nclass VisionTransformerConvStem(VisionTransformer):\n    def __init__(self, image_size, patch_size, in_channels, embed_dim, num_heads,\n                 num_layers, num_classes, feedforward_dim=2048, dropout=0.1):\n        # Build the same ViT as before (same seed -> same transformer weights as model_aug)\n        super().__init__(image_size, patch_size, in_channels, embed_dim, num_heads,\n                         num_layers, num_classes, feedforward_dim, dropout)\n        # Swap only the patch embedding; forward() is inherited unchanged\n        self.patch_embedding = ConvStemEmbedding(in_channels, embed_dim)\n\n\nset_seed(42)\nmodel_stem = VisionTransformerConvStem(224, 16, 3, 384, 8, 8, 2, 1024).to(device)\n\n# Sanity checks: output shape and size of the change\nprint(\"Output shape:\", model_stem(torch.randn(2, 3, 224, 224).to(device)).shape)\nn_aug = sum(p.numel() for p in model_aug.parameters())\nn_stem = sum(p.numel() for p in model_stem.parameters())\nprint(f\"Parameters: augmented = {n_aug:,}, conv stem = {n_stem:,} (+{n_stem - n_aug:,})\")\n\ncriterion_stem = nn.CrossEntropyLoss(weight=torch.tensor([1.0, 0.4], device=device)).to(device)\noptimizer_stem = optim.Adam(model_stem.parameters(), lr=1e-4)\nscheduler_stem = optim.lr_scheduler.CosineAnnealingLR(optimizer_stem, T_max=NUM_EPOCHS, eta_min=1e-6)\n\nmodel_stem, lr_list_stem, loss_list_stem = train_model(\n    model_stem, criterion_stem, optimizer_stem, scheduler_stem, train_loader_aug   # same augmented data\n)\ntorch.save(model_stem.state_dict(), \"chest_xray_vit_aug_convstem.pth\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-29T06:51:36.269307Z","iopub.execute_input":"2026-09-29T06:51:36.269581Z","iopub.status.idle":"2026-09-29T07:05:52.047393Z","shell.execute_reply.started":"2026-09-29T06:51:36.269559Z","shell.execute_reply":"2026-09-29T07:05:52.046617Z"}},"outputs":[{"name":"stdout","text":"Output shape: torch.Size([2, 2])\nParameters: augmented = 11,343,106, conv stem = 12,069,298 (+726,192)\n","output_type":"stream"},{"name":"stderr","text":"Epoch 1/15: 100%|██████████| 326/326 [00:57<00:00,  5.69it/s, loss=0.341] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 1: avg loss = 0.4463, lr = 1.00e-04\n","output_type":"stream"},{"name":"stderr","text":"Epoch 2/15: 100%|██████████| 326/326 [00:57<00:00,  5.66it/s, loss=0.2]   \n","output_type":"stream"},{"name":"stdout","text":"Epoch 2: avg loss = 0.3320, lr = 9.89e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 3/15: 100%|██████████| 326/326 [00:56<00:00,  5.77it/s, loss=0.466] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 3: avg loss = 0.3137, lr = 9.57e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 4/15: 100%|██████████| 326/326 [00:55<00:00,  5.83it/s, loss=0.214] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 4: avg loss = 0.2900, lr = 9.05e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 5/15: 100%|██████████| 326/326 [00:58<00:00,  5.55it/s, loss=0.352] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 5: avg loss = 0.2536, lr = 8.36e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 6/15: 100%|██████████| 326/326 [00:57<00:00,  5.65it/s, loss=0.199] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 6: avg loss = 0.2286, lr = 7.52e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 7/15: 100%|██████████| 326/326 [00:56<00:00,  5.82it/s, loss=0.0617]\n","output_type":"stream"},{"name":"stdout","text":"Epoch 7: avg loss = 0.1972, lr = 6.58e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 8/15: 100%|██████████| 326/326 [00:56<00:00,  5.73it/s, loss=0.0764] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 8: avg loss = 0.1798, lr = 5.57e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 9/15: 100%|██████████| 326/326 [00:56<00:00,  5.74it/s, loss=0.0207] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 9: avg loss = 0.1549, lr = 4.53e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 10/15: 100%|██████████| 326/326 [00:56<00:00,  5.77it/s, loss=0.0721] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 10: avg loss = 0.1431, lr = 3.52e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 11/15: 100%|██████████| 326/326 [00:57<00:00,  5.67it/s, loss=0.181]  \n","output_type":"stream"},{"name":"stdout","text":"Epoch 11: avg loss = 0.1435, lr = 2.58e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 12/15: 100%|██████████| 326/326 [00:58<00:00,  5.60it/s, loss=0.0987] \n","output_type":"stream"},{"name":"stdout","text":"Epoch 12: avg loss = 0.1229, lr = 1.74e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 13/15: 100%|██████████| 326/326 [00:56<00:00,  5.78it/s, loss=0.137]  \n","output_type":"stream"},{"name":"stdout","text":"Epoch 13: avg loss = 0.1145, lr = 1.05e-05\n","output_type":"stream"},{"name":"stderr","text":"Epoch 14/15: 100%|██████████| 326/326 [00:56<00:00,  5.76it/s, loss=0.144]  \n","output_type":"stream"},{"name":"stdout","text":"Epoch 14: avg loss = 0.0963, lr = 5.28e-06\n","output_type":"stream"},{"name":"stderr","text":"Epoch 15/15: 100%|██████████| 326/326 [00:56<00:00,  5.74it/s, loss=0.179]  \n","output_type":"stream"},{"name":"stdout","text":"Epoch 15: avg loss = 0.1028, lr = 2.08e-06\nLR per epoch: ['1.00e-04', '9.89e-05', '9.57e-05', '9.05e-05', '8.36e-05', '7.52e-05', '6.58e-05', '5.57e-05', '4.53e-05', '3.52e-05', '2.58e-05', '1.74e-05', '1.05e-05', '5.28e-06', '2.08e-06']\n","output_type":"stream"}],"execution_count":31},{"cell_type":"code","source":"# ============================================================\n# Evaluate and compare all models\n# ============================================================\nstem_metrics = test_model(model_stem, test_loader, title=\"(Augmented + Conv stem, test set)\")\nstem_train_metrics = test_model(model_stem, train_eval_loader,\n                                title=\"(Augmented + Conv stem, train set)\", plot=False)\n\ncomparison_final = pd.DataFrame({\n    \"Baseline\": baseline_metrics,\n    \"Augmented\": aug_metrics,\n    \"Aug + Positional\": pos_metrics,\n    \"Aug + Conv stem\": stem_metrics,\n}).T\ncomparison_final.loc[\"Change (Conv stem vs Aug)\"] = (\n    comparison_final.loc[\"Aug + Conv stem\"] - comparison_final.loc[\"Augmented\"]\n)\nprint(\"\\nTest-set comparison:\")\ndisplay(comparison_final.round(4))\n\ngap_final = pd.DataFrame({\n    \"Train accuracy\": [baseline_train_metrics[\"Accuracy\"], aug_train_metrics[\"Accuracy\"],\n                       pos_train_metrics[\"Accuracy\"], stem_train_metrics[\"Accuracy\"]],\n    \"Test accuracy\": [baseline_metrics[\"Accuracy\"], aug_metrics[\"Accuracy\"],\n                      pos_metrics[\"Accuracy\"], stem_metrics[\"Accuracy\"]],\n}, index=[\"Baseline\", \"Augmented\", \"Aug + Positional\", \"Aug + Conv stem\"])\ngap_final[\"Gap\"] = gap_final[\"Train accuracy\"] - gap_final[\"Test accuracy\"]\nprint(\"\\nTrain vs test accuracy gap:\")\ndisplay(gap_final.round(4))\n\nplt.figure(figsize=(7, 4))\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list, marker=\"o\", label=\"Baseline\")\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list_aug, marker=\"o\", label=\"Augmented\")\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list_pos, marker=\"o\", label=\"Aug + Positional\")\nplt.plot(range(1, NUM_EPOCHS + 1), loss_list_stem, marker=\"o\", label=\"Aug + Conv stem\")\nplt.xlabel(\"Epoch\")\nplt.ylabel(\"Average training loss\")\nplt.title(\"Training loss comparison\")\nplt.legend()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-29T07:07:12.879252Z","iopub.execute_input":"2026-09-29T07:07:12.879918Z","iopub.status.idle":"2026-09-29T07:08:05.813179Z","shell.execute_reply.started":"2026-09-29T07:07:12.879882Z","shell.execute_reply":"2026-09-29T07:08:05.81225Z"}},"outputs":[{"name":"stdout","text":"--- (Augmented + Conv stem, test set) ---\nAccuracy: 0.8798\nPrecision: 0.8621\nRecall: 0.9615\nSpecificity: 0.7436\nCohen Kappa: 0.7333\nAUC: 0.9542\nFalse positives (NORMAL -> PNEUMONIA): 60, False negatives: 15\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"--- (Augmented + Conv stem, train set) ---\nAccuracy: 0.9590\nPrecision: 0.9946\nRecall: 0.9499\nSpecificity: 0.9851\nCohen Kappa: 0.8970\nAUC: 0.9951\nFalse positives (NORMAL -> PNEUMONIA): 20, False negatives: 194\n\nTest-set comparison:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                           Accuracy  Precision  Recall  Specificity   Kappa  \\\nBaseline                     0.8109     0.8036  0.9231       0.6239  0.5755   \nAugmented                    0.7981     0.8455  0.8282       0.7479  0.5722   \nAug + Positional             0.7869     0.8373  0.8179       0.7350  0.5488   \nAug + Conv stem              0.8798     0.8621  0.9615       0.7436  0.7333   \nChange (Conv stem vs Aug)    0.0817     0.0165  0.1333      -0.0043  0.1612   \n\n                              AUC    FP    FN  \nBaseline                   0.8723  88.0  30.0  \nAugmented                  0.8906  59.0  67.0  \nAug + Positional           0.8794  