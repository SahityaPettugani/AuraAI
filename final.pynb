ckages (from torch) (11.3.3.83)\nRequirement already satisfied: nvidia-curand-cu12==10.3.9.90 in /usr/local/lib/python3.12/dist-packages (from torch) (10.3.9.90)\nRequirement already satisfied: nvidia-cusolver-cu12==11.7.3.90 in /usr/local/lib/python3.12/dist-packages (from torch) (11.7.3.90)\nRequirement already satisfied: nvidia-cusparse-cu12==12.5.8.93 in /usr/local/lib/python3.12/dist-packages (from torch) (12.5.8.93)\nRequirement already satisfied: nvidia-cusparselt-cu12==0.7.1 in /usr/local/lib/python3.12/dist-packages (from torch) (0.7.1)\nRequirement already satisfied: nvidia-nccl-cu12==2.27.5 in /usr/local/lib/python3.12/dist-packages (from torch) (2.27.5)\nRequirement already satisfied: nvidia-nvshmem-cu12==3.4.5 in /usr/local/lib/python3.12/dist-packages (from torch) (3.4.5)\nRequirement already satisfied: nvidia-nvtx-cu12==12.8.90 in /usr/local/lib/python3.12/dist-packages (from torch) (12.8.90)\nRequirement already satisfied: nvidia-nvjitlink-cu12==12.8.93 in /usr/local/lib/python3.12/dist-packages (from torch) (12.8.93)\nRequirement already satisfied: nvidia-cufile-cu12==1.13.1.3 in /usr/local/lib/python3.12/dist-packages (from torch) (1.13.1.3)\nRequirement already satisfied: triton==3.6.0 in /usr/local/lib/python3.12/dist-packages (from torch) (3.6.0)\nRequirement already satisfied: cuda-pathfinder~=1.1 in /usr/local/lib/python3.12/dist-packages (from cuda-bindings==12.9.4->torch) (1.5.3)\nRequirement already satisfied: numpy in /usr/local/lib/python3.12/dist-packages (from torchvision) (2.0.2)\nRequirement already satisfied: contourpy>=1.0.1 in /usr/local/lib/python3.12/dist-packages (from matplotlib) (1.3.3)\nRequirement already satisfied: cycler>=0.10 in /usr/local/lib/python3.12/dist-packages (from matplotlib) (0.12.1)\nRequirement already satisfied: fonttools>=4.22.0 in /usr/local/lib/python3.12/dist-packages (from matplotlib) (4.62.1)\nRequirement already satisfied: kiwisolver>=1.3.1 in /usr/local/lib/python3.12/dist-packages (from matplotlib) (1.5.0)\nRequirement already satisfied: packaging>=20.0 in /usr/local/lib/python3.12/dist-packages (from matplotlib) (26.1)\nRequirement already satisfied: pyparsing>=2.3.1 in /usr/local/lib/python3.12/dist-packages (from matplotlib) (3.3.2)\nRequirement already satisfied: python-dateutil>=2.7 in /usr/local/lib/python3.12/dist-packages (from matplotlib) (2.9.0.post0)\nRequirement already satisfied: six>=1.5 in /usr/local/lib/python3.12/dist-packages (from python-dateutil>=2.7->matplotlib) (1.17.0)\nRequirement already satisfied: mpmath<1.4,>=1.1.0 in /usr/local/lib/python3.12/dist-packages (from sympy>=1.13.3->torch) (1.3.0)\nRequirement already satisfied: MarkupSafe>=2.0 in /usr/local/lib/python3.12/dist-packages (from jinja2->torch) (3.0.3)\n","output_type":"stream"}],"execution_count":33},{"cell_type":"markdown","source":"Data download\n\nPlease download the dataset from https://drive.google.com/drive/folders/1HE2sHfnMU8ZUH26d0mIiXblzJrG2ZEpd?usp=drive_link to to implement a detection task over Chest X-ray images.\n\nThere are two folders: **train** and **test**, which contain the images for the training and testing datasets, respectively.\n\nThere are also two accompanying files:\n\n- train.json: annotations for the training data\n\n- test.json: annotations for the test data","metadata":{"id":"VOn48I-S6iKc"}},{"cell_type":"markdown","source":"**Step 1:**\n\n**Please implement a custom PyTorch Dataset class for loading chest X-ray images with their corresponding bounding box annotations. Please pay attention to the format required by the Faster R-CNN model (1 point).**","metadata":{"id":"AOZrhCje6kpt"}},{"cell_type":"code","source":"import torch\nimport torchvision.transforms as T\nimport numpy as np\nimport os, json, shutil\n\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image\n\n\n# ============================================================\n# Data setup: gather the uploaded folders into the layout the\n# code expects (BASE/train, BASE/test, BASE/train.json, BASE/test.json).\n# Uses links, so nothing is copied. /kaggle/working is wiped on\n# restart, so this runs every time.\n# ============================================================\nSRC = \"/kaggle/input/datasets/sahityapettugani/assignment2\"\nBASE = \"/kaggle/working/chestxdet10\"\n\nif os.path.exists(BASE):\n    shutil.rmtree(BASE)\nos.makedirs(BASE)\n\nfound = {}\nfor root, dirs, files in os.walk(SRC):\n    name = os.path.basename(root).lower()\n    n_png = sum(f.lower().endswith(\".png\") for f in files)\n    for split in (\"train\", \"test\"):\n        if n_png > 0 and name.startswith(split) and split not in found:\n            found[split] = root\n    for f in files:\n        if f in (\"train.json\", \"test.json\") and f not in found:\n            found[f] = os.path.join(root, f)\n\nfor key in (\"train\", \"test\", \"train.json\", \"test.json\"):\n    if key not in found:\n        raise FileNotFoundError(f\"Could not find '{key}' under {SRC}\")\n    os.symlink(found[key], os.path.join(BASE, key))\n\nprint(\"Data folder:\", BASE)\n\n# /kaggle/input is read-only, so all outputs go here\nOUT_DIR = \"/kaggle/working\"\n\n\n# ============================================================\n# Dataset\n# ============================================================\n# In this dataset, we only detect consolidation\nCLASSES = [\"Consolidation\"]\nCLS2ID = {c: i + 1 for i, c in enumerate(CLASSES)}\n\n\nclass ChestXDet10(Dataset):\n    def __init__(self, base, split=\"train\", transforms=None):\n        self.base = base\n        self.split = split\n        self.transforms = transforms\n        self.img_dir = f\"{base}/{split}\"\n        self.ann = self.read_json(f\"{base}/{split}.json\")\n\n        self.items = []\n        for it in self.ann:\n            p = self._try_read(os.path.join(self.img_dir, it[\"file_name\"]))\n            if p:\n                self.items.append((p, it))\n        print(f\"[{split}] usable images:\", len(self.items))\n\n    def read_json(self, path):\n        with open(path, \"r\") as f:\n            return json.load(f)\n\n    def _try_read(self, img_path):\n        if os.path.exists(img_path):\n            return img_path\n        alt = img_path.replace(\".png\", \".PNG\")\n        return alt if os.path.exists(alt) else None\n\n    def __len__(self):\n        return len(self.items)\n\n    def __getitem__(self, idx):\n        '''\n            Expected output:\n            img: tensor of shape (3, H, W)\n            target: dict of the following keys:\n                boxes: tensor of shape (N, 4)  # [x1, y1, x2, y2]\n                labels: tensor of shape (N)\n            img_path: the path of the image\n        '''\n        img_path, it = self.items[idx]\n\n        # Load the image as RGB (3 channels)\n        img = Image.open(img_path).convert(\"RGB\")\n        w, h = img.size\n\n        syms = it.get(\"syms\", [])\n        raw_boxes = it.get(\"boxes\", [])\n\n        # Keep only the classes we detect (guards against other ChestXDet10 labels)\n        pairs = [(s, b) for s, b in zip(syms, raw_boxes) if s in CLS2ID]\n        if pairs:\n            boxes = np.array([b for _, b in pairs], dtype=np.float32).reshape(-1, 4)\n            labels = np.array([CLS2ID[s] for s, _ in pairs], dtype=np.int64)\n        else:\n            boxes = np.zeros((0, 4), dtype=np.float32)\n            labels = np.zeros((0,), dtype=np.int64)\n\n        # Clamp boxes to the image\n        if len(boxes):\n            boxes[:, 0::2] = np.clip(boxes[:, 0::2], 0, w - 1)\n            boxes[:, 1::2] = np.clip(boxes[:, 1::2], 0, h - 1)\n            # Drop zero-size boxes (Faster R-CNN rejects them)\n            valid = (boxes[:, 2] > boxes[:, 0]) & (boxes[:, 3] > boxes[:, 1])\n            boxes, labels = boxes[valid], labels[valid]\n\n        # Coordinates are float; class labels are int64\n        target = {\n            \"boxes\": torch.as_tensor(boxes, dtype=torch.float32),\n            \"labels\": torch.as_tensor(labels, dtype=torch.int64),\n        }\n\n        if self.transforms:\n            img = self.transforms(img)\n\n        return img, target, os.path.basename(img_path)\n\n\ndef collate_fn(batch):\n    imgs, targets, names = list(zip(*batch))\n    return list(imgs), list(targets), list(names)\n\n\ntrain_tfms = T.Compose([T.ToTensor()])\ntest_tfms = T.Compose([T.ToTensor()])\n\ntrain_set = ChestXDet10(BASE, \"train\", transforms=train_tfms)\ntest_set = ChestXDet10(BASE, \"test\", transforms=test_tfms)\n\n# Batch size 4 due to the memory limit\ntrain_loader = DataLoader(train_set, batch_size=4, shuffle=True, num_workers=2, collate_fn=collate_fn)\ntest_loader = DataLoader(test_set, batch_size=4, shuffle=False, num_workers=2, collate_fn=collate_fn)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T14:50:03.728883Z","iopub.execute_input":"2026-10-11T14:50:03.729151Z","iopub.status.idle":"2026-10-11T14:50:17.239942Z","shell.execute_reply.started":"2026-10-11T14:50:03.729119Z","shell.execute_reply":"2026-10-11T14:50:17.239245Z"}},"outputs":[{"name":"stdout","text":"Data folder: /kaggle/working/chestxdet10\n[train] usable images: 965\n[test] usable images: 125\n","output_type":"stream"}],"execution_count":1},{"cell_type":"markdown","source":"**Step 2:**\n\n**Please set up the Faster R-CNN model architecture with ResNet-50 backbone. This involves defining box head and box predictor (2 points).**","metadata":{"id":"1whU4nDy6q4T"}},{"cell_type":"code","source":"import torch\nimport torch.nn.functional as F\nfrom torch import nn\nfrom torchvision.ops import MultiScaleRoIAlign\nfrom torchvision.models.detection.rpn import AnchorGenerator, RPNHead, RegionProposalNetwork\nfrom torchvision.models.detection.roi_heads import RoIHeads\nfrom torchvision.models.detection.generalized_rcnn import GeneralizedRCNN\nfrom torchvision.models.detection.transform import GeneralizedRCNNTransform\nfrom torchvision.models.detection._utils import overwrite_eps\nfrom torchvision.models.detection.backbone_utils import (\n    _resnet_fpn_extractor,\n    _validate_trainable_layers,\n)\nfrom torchvision.models import resnet50, ResNet50_Weights\nfrom torchvision.ops import misc as misc_nn_ops\nfrom torch.hub import load_state_dict_from_url\n\n\nclass FasterRCNN(GeneralizedRCNN):\n    \"\"\"\n    Implements Faster R-CNN (RPN + RoI heads) on top of a given backbone.\n    Training: model(images, targets) returns a dict of losses.\n    Inference: model(images) returns a list of dicts with boxes, labels and scores.\n    \"\"\"\n\n    def __init__(\n        self,\n        backbone,\n        num_classes=None,\n        # transform parameters\n        min_size=800,\n        max_size=1333,\n        image_mean=None,\n        image_std=None,\n        # RPN parameters\n        rpn_anchor_generator=None,\n        rpn_head=None,\n        rpn_pre_nms_top_n_train=2000,\n        rpn_pre_nms_top_n_test=1000,\n        rpn_post_nms_top_n_train=2000,\n        rpn_post_nms_top_n_test=1000,\n        rpn_nms_thresh=0.7,\n        rpn_fg_iou_thresh=0.7,\n        rpn_bg_iou_thresh=0.3,\n        rpn_batch_size_per_image=256,\n        rpn_positive_fraction=0.5,\n        rpn_score_thresh=0.0,\n        # Box parameters\n        box_roi_pool=None,\n        box_head=None,\n        box_predictor=None,\n        box_score_thresh=0.05,\n        box_nms_thresh=0.5,\n        box_detections_per_img=100,\n        box_fg_iou_thresh=0.5,\n        box_bg_iou_thresh=0.5,\n        box_batch_size_per_image=512,\n        box_positive_fraction=0.25,\n        bbox_reg_weights=None,\n    ):\n        if not hasattr(backbone, \"out_channels\"):\n            raise ValueError(\n                \"backbone should contain an attribute out_channels \"\n                \"specifying the number of output channels (assumed to be the \"\n                \"same for all the levels)\"\n            )\n\n        assert isinstance(rpn_anchor_generator, (AnchorGenerator, type(None)))\n        assert isinstance(box_roi_pool, (MultiScaleRoIAlign, type(None)))\n\n        out_channels = backbone.out_channels\n\n        if rpn_anchor_generator is None:\n            anchor_sizes = ((32,), (64,), (128,), (256,), (512,))\n            aspect_ratios = ((0.5, 1.0, 2.0),) * len(anchor_sizes)\n            rpn_anchor_generator = AnchorGenerator(anchor_sizes, aspect_ratios)\n        if rpn_head is None:\n            rpn_head = RPNHead(out_channels, rpn_anchor_generator.num_anchors_per_location()[0])\n\n        rpn_pre_nms_top_n = dict(training=rpn_pre_nms_top_n_train, testing=rpn_pre_nms_top_n_test)\n        rpn_post_nms_top_n = dict(training=rpn_post_nms_top_n_train, testing=rpn_post_nms_top_n_test)\n\n        rpn = RegionProposalNetwork(\n            rpn_anchor_generator,\n            rpn_head,\n            rpn_fg_iou_thresh,\n            rpn_bg_iou_thresh,\n            rpn_batch_size_per_image,\n            rpn_positive_fraction,\n            rpn_pre_nms_top_n,\n            rpn_post_nms_top_n,\n            rpn_nms_thresh,\n            score_thresh=rpn_score_thresh,\n        )\n\n        if box_roi_pool is None:\n            box_roi_pool = MultiScaleRoIAlign(featmap_names=[\"0\", \"1\", \"2\", \"3\"], output_size=7, sampling_ratio=2)\n\n        if box_head is None:\n            resolution = box_roi_pool.output_size[0]\n            representation_size = 1024\n            box_head = TwoMLPHead(out_channels * resolution ** 2, representation_size)\n\n        if box_predictor is None:\n            representation_size = 1024\n            box_predictor = FastRCNNPredictor(representation_size, num_classes)\n\n        roi_heads = RoIHeads(\n            box_roi_pool,\n            box_head,\n            box_predictor,\n            box_fg_iou_thresh,\n            box_bg_iou_thresh,\n            box_batch_size_per_image,\n            box_positive_fraction,\n            bbox_reg_weights,\n            box_score_thresh,\n            box_nms_thresh,\n            box_detections_per_img,\n        )\n\n        if image_mean is None:\n            image_mean = [0.485, 0.456, 0.406]\n        if image_std is None:\n            image_std = [0.229, 0.224, 0.225]\n        transform = GeneralizedRCNNTransform(min_size, max_size, image_mean, image_std)\n\n        super().__init__(backbone, rpn, roi_heads, transform)\n\n\nclass TwoMLPHead(nn.Module):\n    \"\"\"\n    Standard heads for FPN-based models\n\n    Args:\n        in_channels (int): number of input channels\n        representation_size (int): size of the intermediate representation\n    \"\"\"\n\n    def __init__(self, in_channels, representation_size):\n        super().__init__()\n        # in_channels = 256 * 7 * 7 = 12544 (one flattened RoI crop)\n        self.fc6 = nn.Linear(in_channels, representation_size)          # 12544 -> 1024\n        self.fc7 = nn.Linear(representation_size, representation_size)  # 1024 -> 1024\n\n    def forward(self, x):\n        x = x.flatten(start_dim=1)   # [N, 256, 7, 7] -> [N, 12544]\n        x = F.relu(self.fc6(x))\n        x = F.relu(self.fc7(x))\n        return x\n\n\nclass FastRCNNPredictor(nn.Module):\n    \"\"\"\n    Standard classification + bounding box regression layers\n    for Fast R-CNN.\n\n    Args:\n        in_channels (int): number of input channels\n        num_classes (int): number of output classes (including background)\n    \"\"\"\n\n    def __init__(self, in_channels, num_classes):\n        super().__init__()\n        self.cls_score = nn.Linear(in_channels, num_classes)       # class logits\n        self.bbox_pred = nn.Linear(in_channels, num_classes * 4)   # 4 box deltas per class\n\n    def forward(self, x):\n        if x.dim() == 4:\n            assert list(x.shape[2:]) == [1, 1]\n\n        x = x.flatten(start_dim=1)       # [N, 1024]\n\n        scores = self.cls_score(x)       # [N, num_classes]\n        bbox_deltas = self.bbox_pred(x)  # [N, num_classes * 4]\n\n        return scores, bbox_deltas\n\n\nmodel_urls = {\n    \"fasterrcnn_resnet50_fpn_coco\": \"https://download.pytorch.org/models/fasterrcnn_resnet50_fpn_coco-258fb6c6.pth\",\n}\n\n\ndef fasterrcnn_resnet50_fpn(\n    pretrained=False, progress=True, num_classes=91, pretrained_backbone=True, trainable_backbone_layers=None, **kwargs\n):\n    \"\"\"\n    Constructs a Faster R-CNN model with a ResNet-50-FPN backbone.\n\n    Args:\n        pretrained (bool): If True, returns a model pre-trained on COCO train2017\n        progress (bool): If True, displays a progress bar of the download\n        num_classes (int): number of output classes (including the background)\n        pretrained_backbone (bool): If True, uses a backbone pre-trained on ImageNet\n        trainable_backbone_layers (int): number of trainable ResNet layers (0-5), default 3\n    \"\"\"\n    trainable_backbone_layers = _validate_trainable_layers(\n        pretrained or pretrained_backbone, trainable_backbone_layers, 5, 3\n    )\n\n    if pretrained:\n        pretrained_backbone = False\n\n    # Current torchvision API for ImageNet-pretrained weights\n    weights = ResNet50_Weights.IMAGENET1K_V1 if pretrained_backbone else None\n    backbone = resnet50(weights=weights, progress=progress, norm_layer=misc_nn_ops.FrozenBatchNorm2d)\n    backbone = _resnet_fpn_extractor(backbone, trainable_backbone_layers)\n    model = FasterRCNN(backbone, num_classes, **kwargs)\n    if pretrained:\n        state_dict = load_state_dict_from_url(model_urls[\"fasterrcnn_resnet50_fpn_coco\"], progress=progress)\n        model.load_state_dict(state_dict)\n        overwrite_eps(model, 0.0)\n    return model\n\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nmodel = fasterrcnn_resnet50_fpn(pretrained_backbone=True, num_classes=len(CLASSES) + 1)\nprint(\"Model created on:\", device)","metadata":{"id":"prhUIji26g77","trusted":true,"execution":{"iopub.status.busy":"2026-10-11T14:54:07.866872Z","iopub.execute_input":"2026-10-11T14:54:07.867689Z","iopub.status.idle":"2026-10-11T14:54:09.411928Z","shell.execute_reply.started":"2026-10-11T14:54:07.867661Z","shell.execute_reply":"2026-10-11T14:54:09.41129Z"}},"outputs":[{"name":"stdout","text":"Downloading: \"https://download.pytorch.org/models/resnet50-0676ba61.pth\" to /root/.cache/torch/hub/checkpoints/resnet50-0676ba61.pth\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 97.8M/97.8M [00:00<00:00, 232MB/s]\n","output_type":"stream"},{"name":"stdout","text":"Model created on: cuda\n","output_type":"stream"}],"execution_count":3},{"cell_type":"markdown","source":"**Step 3**:\n\n**Please implement the training loop and model optimization. Also please implement the learning rate decay (1 point).**\n","metadata":{"id":"DED2lqcq6zyk"}},{"cell_type":"code","source":"from tqdm import tqdm\nimport torch\nimport torch.nn as nn\n\nmodel = model.to(device)   # missing from the template\n\nEPOCHS = 5   # Here we only train for 5 epochs\n\nparams = [p for p in model.parameters() if p.requires_grad]\noptimizer = torch.optim.AdamW(params, lr=0.00005, weight_decay=1e-4)\n\n# Cosine LR decay: 5e-5 -> 1e-6 over the 5 epochs\nlr_scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS, eta_min=1e-6)\n\n\ndef train_one_epoch(model, optimizer, data_loader, device):\n    model.train()\n    pbar = tqdm(enumerate(data_loader), total=len(data_loader))\n    total_loss = 0.0\n\n    for i, (images, targets, _) in pbar:\n        images = [img.to(device) for img in images]\n        targets = [{k: v.to(device) for k, v in t.items()} for t in targets]\n\n        # In training mode, the model returns its own dictionary of losses\n        loss_dict = model(images, targets)\n        losses = sum(loss for loss in loss_dict.values())\n        loss_value = losses.item()\n\n        optimizer.zero_grad()\n        losses.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        optimizer.step()\n\n        total_loss += loss_value\n        pbar.set_postfix(loss=loss_value)\n\n    return total_loss / len(data_loader)\n\n\nloss_history, lr_history = [], []\nfor epoch in range(EPOCHS):\n    lr_history.append(optimizer.param_groups[0][\"lr\"])\n    avg_loss = train_one_epoch(model, optimizer, train_loader, device)\n    loss_history.append(avg_loss)\n    print(f\"Epoch {epoch} loss: {avg_loss:.4f}, lr: {lr_history[-1]:.2e}\")\n    lr_scheduler.step()\n\nprint(\"LR per epoch:\", [f\"{lr:.2e}\" for lr in lr_history])\n\n# Save the model to the writable folder\nWEIGHTS = f\"{OUT_DIR}/fasterrcnn_chestxdet10.pth\"\ntorch.save(model.state_dict(), WEIGHTS)\nprint(\"saved to:\", WEIGHTS)","metadata":{"id":"7uo-jXfe5sop","trusted":true,"execution":{"iopub.status.busy":"2026-10-11T14:54:37.423392Z","iopub.execute_input":"2026-10-11T14:54:37.424263Z","iopub.status.idle":"2026-10-11T15:12:19.867673Z","shell.execute_reply.started":"2026-10-11T14:54:37.424196Z","shell.execute_reply":"2026-10-11T15:12:19.866655Z"}},"outputs":[{"name":"stderr","text":"100%|██████████| 242/242 [03:25<00:00,  1.18it/s, loss=0.526]   ","output_type":"stream"},{"name":"stdout","text":"Epoch 0 loss: 0.1384, lr: 5.00e-05\n","output_type":"stream"},{"name":"stderr","text":"\n100%|██████████| 242/242 [03:32<00:00,  1.14it/s, loss=0.00463]","output_type":"stream"},{"name":"stdout","text":"Epoch 1 loss: 0.1115, lr: 4.53e-05\n","output_type":"stream"},{"name":"stderr","text":"\n100%|██████████| 242/242 [03:33<00:00,  1.13it/s, loss=0.197]  ","output_type":"stream"},{"name":"stdout","text":"Epoch 2 loss: 0.1030, lr: 3.31e-05\n","output_type":"stream"},{"name":"stderr","text":"\n100%|██████████| 242/242 [03:34<00:00,  1.13it/s, loss=0.00703]","output_type":"stream"},{"name":"stdout","text":"Epoch 3 loss: 0.0911, lr: 1.79e-05\n","output_type":"stream"},{"name":"stderr","text":"\n100%|██████████| 242/242 [03:34<00:00,  1.13it/s, loss=0.246]   \n","output_type":"stream"},{"name":"stdout","text":"Epoch 4 loss: 0.0807, lr: 5.68e-06\nLR per epoch: ['5.00e-05', '4.53e-05', '3.31e-05', '1.79e-05', '5.68e-06']\nsaved to: /kaggle/working/fasterrcnn_chestxdet10.pth\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":"**Step 4: (1 point)**\n\nAfter training, please use the trained model to generate predictions on the test set. In this step, you should:\n1. Model Inference: Run trained model on test images\n\n2. Confidence Filtering: Apply score threshold to filter low-confidence predictions\n\n3. Output Formatting: Convert predictions to evaluation format\n\n4. File Management: Save predictions as JSON files and save the predictions in the pred_json folder\n\n\n**Output Format:**\n\nEach prediction file should be named as the original image name with .json extension.\nEach prediction file contains:\n- Class Name: \"Consolidation\" for detected regions\n\n- Coordinates: [x1, y1, x2, y2] bounding box coordinates\n\n- Confidence: Detection confidence score\n\n[{\"Class Name\": [x1, y1, x2, y2, confidence]}]\n\nExample:\n\n[{\"Consolidation\": [570.3914184570312, 419.7106018066406, 709.7536010742188, 596.7514038085938, 0.27996760606765747]}]\n\n[{\"Consolidation\": [235.6313934326172, 356.14544677734375, 435.51422119140625, 753.4442138671875, 0.8444843888282776]}, {\"Consolidation\": [598.0247192382812, 368.6965637207031, 798.2308959960938, 758.9693603515625, 0.4207973778247833]}]","metadata":{"id":"VOa97izq63Ug"}},{"cell_type":"code","source":"import torch\nimport json, os\nfrom tqdm import tqdm\n\nmodel.eval()\npred_dir = f\"{OUT_DIR}/pred_json\"   # outside BASE, because Step 1 rebuilds BASE on every run\nos.makedirs(pred_dir, exist_ok=True)\n\nscore_thresh = 0.02\n\nwith torch.no_grad():\n    for images, targets, names in tqdm(test_loader):\n        # Model inference and prediction\n        images_gpu = [img.to(device) for img in images]   # todo1: move the images to the GPU\n        outputs = model(images_gpu)                       # todo2: run inference\n\n        for name, out, im in zip(names, outputs, images):\n            boxes = out[\"boxes\"].cpu().numpy()\n            scores = out[\"scores\"].cpu().numpy()\n            labels = out[\"labels\"].cpu().numpy()\n\n            per_image = []\n            for (x1,y1,x2,y2), sc, lb in zip(boxes, scores, labels):\n                if sc < score_thresh:\n                    continue\n                # label==0 background; TorchVision's label>=1 corresponds to our classes\n                if lb == 0:\n                    continue\n                cls_name = CLASSES[lb-1]\n                per_image.append({cls_name: [float(x1), float(y1), float(x2), float(y2), float(sc)]})\n\n            out_path = os.path.join(pred_dir, os.path.splitext(name)[0] + \".json\")\n            with open(out_path, \"w\") as f:\n                json.dump(per_image, f)\n\n\nlen(os.listdir(pred_dir))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:22:50.861373Z","iopub.execute_input":"2026-10-11T15:22:50.86171Z","iopub.status.idle":"2026-10-11T15:23:04.311054Z","shell.execute_reply.started":"2026-10-11T15:22:50.861683Z","shell.execute_reply":"2026-10-11T15:23:04.310157Z"}},"outputs":[{"name":"stderr","text":"100%|██████████| 32/32 [00:13<00:00,  2.38it/s]\n","output_type":"stream"},{"execution_count":15,"output_type":"execute_result","data":{"text/plain":"125"},"metadata":{}}],"execution_count":15},{"cell_type":"markdown","source":"**Step 5:**\n\n**Now you need to implement the compuation of IOU to get the evaluation of your prediction (1 point).**\n","metadata":{"id":"mArk0oMG67Lg"}},{"cell_type":"code","source":"import numpy as np\nimport json\nimport os\n\nfrom scipy import interpolate\n\n\ndef IOU(box1, gts):\n    # Intersection rectangle between box1 and every ground-truth box.\n    # Coordinates are inclusive, so width = x2 - x1 + 1 and height = y2 - y1 + 1.\n    ixmin = np.maximum(gts[:, 0], box1[0])\n    iymin = np.maximum(gts[:, 1], box1[1])\n    ixmax = np.minimum(gts[:, 2], box1[2])\n    iymax = np.minimum(gts[:, 3], box1[3])\n\n    # Intersection width and height (0 if the boxes don't overlap)\n    iw = np.maximum(ixmax - ixmin + 1., 0.)\n    ih = np.maximum(iymax - iymin + 1., 0.)\n\n    inters = iw * ih\n\n    # union\n    uni = ((box1[2] - box1[0] + 1.) * (box1[3] - box1[1] + 1.) +\n           (gts[:, 2] - gts[:, 0] + 1.) *\n           (gts[:, 3] - gts[:, 1] + 1.) - inters)\n\n    overlaps = inters / uni\n    return overlaps\n\n\ndef FROC(boxes_all, gts_all, iou_th):\n    # Compute the FROC curve, for single class only\n    nImg = len(boxes_all)\n    img_idxs_ori = np.hstack([[i] * len(boxes_all[i]) for i in range(nImg)]).astype(int)\n    boxes_cat = np.vstack(boxes_all)\n    scores = boxes_cat[:, -1]\n    ord = np.argsort(scores)[::-1]\n    boxes_cat = boxes_cat[ord, :4]\n    img_idxs = img_idxs_ori[ord]\n\n    hits = [np.zeros((len(gts),), dtype=bool) for gts in gts_all]\n    nHits = 0\n    nMiss = 0\n    tps = []\n    fps = []\n    precisions = []\n\n    for i in range(len(boxes_cat)):\n        overlaps = IOU(boxes_cat[i, :], gts_all[img_idxs[i]])\n        if overlaps.shape[0] == 0:\n            nMiss += 1\n        elif overlaps.max() < iou_th:\n            nMiss += 1\n        else:\n            max_index = np.argmax(overlaps)\n            if overlaps[max_index] >= iou_th and not hits[img_idxs[i]][max_index]:\n                hits[img_idxs[i]][max_index] = True\n                nHits += 1\n            elif overlaps[max_index] >= iou_th and hits[img_idxs[i]][max_index]:\n                nMiss += 1\n\n        tps.append(nHits)\n        fps.append(nMiss)\n        if nHits + nMiss > 0:\n            precisions.append(nHits / (nHits + nMiss))\n        else:\n            precisions.append(0.0)\n\n    nGt = len(np.vstack(gts_all))\n    sens = np.array(tps, dtype=float) / nGt\n    fp_per_img = np.array(fps, dtype=float) / nImg\n    precisions = np.array(precisions, dtype=float)\n\n    if len(tps) != 0:\n        tp_gt = [tps[-1], nGt]\n    else:\n        tp_gt = None\n\n    return tp_gt, sens, fp_per_img, precisions\n\n\ndef eval_FROC(gt_boxes, all_boxes, CLASSES, avgFP=[0.05, 0.1, 0.2, 0.5], iou_th=0.5):\n    mean_recall = [0.0 for _ in range(len(avgFP) + 1)]\n    mean_precision = [0.0 for _ in range(len(avgFP) + 1)]\n\n    for cls in range(len(all_boxes)):\n        tp_gt, sens, fp_per_img, precisions = FROC(all_boxes[cls], gt_boxes[cls], iou_th)\n\n        # interpolate precision and recall\n        if len(fp_per_img) > 1:\n            f_recall = interpolate.interp1d(fp_per_img, sens, fill_value=\"extrapolate\")\n            f_precision = interpolate.interp1d(fp_per_img, precisions, fill_value=\"extrapolate\")\n        else:\n            continue\n\n        for idx, fp in enumerate(avgFP):\n            if fp <= fp_per_img[-1]:\n                mean_recall[idx] += float(f_recall(fp))\n                mean_precision[idx] += float(f_precision(fp))\n\n    print('=' * 20, 'Recall & Precision', '=' * 20)\n    for i, fp in enumerate(avgFP):\n        print('Recall@%.2f=%.2f%%, Precision@%.2f=%.2f%%' %\n              (fp, mean_recall[i] / len(CLASSES) * 100.0,\n               fp, mean_precision[i] / len(CLASSES) * 100.0))\n\n\ndef get_pred_info(pred_dir, file_id_list, CLASSES):\n    class_num = len(CLASSES)\n    all_boxes = [[] for _ in range(class_num)]\n\n    for cls_idx, class_name in enumerate(CLASSES):\n        for file_id in file_id_list[cls_idx]:\n            file_id = file_id.replace('.png', '.json')\n            json_file = os.path.join(pred_dir, file_id)\n            all_box = []\n            if os.path.exists(json_file) and os.stat(json_file).st_size > 0:\n                annos = json.load(open(json_file))\n                for i in range(len(annos)):\n                    if class_name in annos[i].keys():\n                        all_box.append(annos[i][class_name])\n                    elif class_name.lower() in annos[i].keys():\n                        all_box.append(annos[i][class_name.lower()])\n            if all_box:\n                all_box = np.array(all_box, dtype=np.float32)\n            else:\n                all_box = np.zeros((0, 5), dtype=np.float32)\n            all_boxes[cls_idx].append(all_box)\n\n    return all_boxes\n\n\ndef get_gt_info(test_json, CLASSES):\n    class_num = len(CLASSES)\n    gt_boxes = [[] for _ in range(class_num)]\n    file_id_list = [[] for _ in range(class_num)]\n\n    annos = json.load(open(test_json))\n    for cls_idx, class_name in enumerate(CLASSES):\n        for entry in annos:\n            syms, boxes = entry['syms'], entry['boxes']\n            file_name = entry['file_name']\n            gt_box = []\n            for idx, (sym, box) in enumerate(zip(syms, boxes)):\n                if sym == class_name:\n                    gt_box.append(box)\n            if gt_box:\n                gt_box = np.array(gt_box, dtype=np.float32)\n            else:\n                gt_box = np.zeros((0, 4), dtype=np.float32)\n            gt_boxes[cls_idx].append(gt_box)\n            file_id_list[cls_idx].append(file_name)\n\n    return gt_boxes, file_id_list\n\n\ntest_json = BASE + \"/test.json\"             # ground truth\npred_dir = \"/kaggle/working/pred_json\"      # predictions from Step 4\n\ngt_boxes, file_id_list = get_gt_info(test_json, CLASSES)\nall_boxes = get_pred_info(pred_dir, file_id_list, CLASSES)\nprint(\"Predicted boxes loaded:\", sum(len(b) for b in all_boxes[0]),\n      \"| ground-truth boxes:\", sum(len(g) for g in gt_boxes[0]))\neval_FROC(gt_boxes, all_boxes, CLASSES)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:23:37.451157Z","iopub.execute_input":"2026-10-11T15:23:37.45164Z","iopub.status.idle":"2026-10-11T15:23:37.504777Z","shell.execute_reply.started":"2026-10-11T15:23:37.451612Z","shell.execute_reply":"2026-10-11T15:23:37.50415Z"}},"outputs":[{"name":"stdout","text":"Predicted boxes loaded: 599 | ground-truth boxes: 72\n==================== Recall & Precision ====================\nRecall@0.05=29.17%, Precision@0.05=77.08%\nRecall@0.10=31.94%, Precision@0.10=64.80%\nRecall@0.20=48.61%, Precision@0.20=58.33%\nRecall@0.50=58.33%, Precision@0.50=40.19%\n","output_type":"stream"}],"execution_count":18},{"cell_type":"code","source":"import os\nprint(os.listdir(\"/kaggle/working\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:18:25.579976Z","iopub.execute_input":"2026-10-11T15:18:25.580376Z","iopub.status.idle":"2026-10-11T15:18:25.585566Z","shell.execute_reply.started":"2026-10-11T15:18:25.580348Z","shell.execute_reply":"2026-10-11T15:18:25.584777Z"}},"outputs":[{"name":"stdout","text":"['fasterrcnn_chestxdet10.pth', 'pred_json', 'chestxdet10', '.virtual_documents']\n","output_type":"stream"}],"execution_count":14},{"cell_type":"markdown","source":"**Step 6**:\n\n**Please create visual comparisons between model predictions and ground truth annotations.** This helps understand the model's performance qualitatively and identify areas for improvement. **(1 point)**","metadata":{"id":"vlFJd8y-6_W1"}},{"cell_type":"code","source":"import torch\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport torchvision.transforms as T\nfrom PIL import ImageDraw\n\n\ndef draw_boxes_pil(img, boxes, labels, classes, scores=None,\n                   color=\"red\", text_color=\"white\"):\n    # Draw boxes (and optional scores) on a copy of the image\n    img = img.copy()\n    draw = ImageDraw.Draw(img)\n\n    for i, box in enumerate(boxes):\n        x1, y1, x2, y2 = [int(v) for v in box]\n        draw.rectangle([x1, y1, x2, y2], outline=color, width=2)\n\n        if len(labels) > 0:\n            lb = int(labels[i])\n            if 1 <= lb <= len(classes):\n                name = classes[lb - 1]\n            else:\n                name = f\"cls{lb}\"\n        else:\n            name = \"\"\n\n        if scores is not None:\n            txt = f\"{name}:{float(scores[i]):.2f}\"\n        else:\n            txt = name if name else \"GT\"\n\n        tw = len(txt) * 6\n        th = 12\n        draw.rectangle([x1, max(0, y1 - th), x1 + tw + 4, y1], fill=color)\n        draw.text((x1 + 2, y1 - th), txt, fill=text_color)\n\n    return img\n\n\n@torch.no_grad()\ndef viz_pred_gt_fixed(model, dataset, classes, filenames, score_thresh=0.3, device=None):\n    \"\"\"\n    Top row: predictions (red, with confidence). Bottom row: ground truth (green).\n    \"\"\"\n    model.eval()\n    device = device or (torch.device(\"cuda\") if torch.cuda.is_available() else torch.device(\"cpu\"))\n\n    cols = len(filenames)\n    fig, axes = plt.subplots(2, cols, figsize=(4 * cols, 8))\n    if cols == 1:\n        axes = np.array([[axes[0]], [axes[1]]])\n\n    # Find the index of each filename in the dataset\n    name2idx = {os.path.basename(it[\"file_name\"]): i for i, (_, it) in enumerate(dataset.items)} \\\n               if hasattr(dataset, \"items\") else {dataset[i][2]: i for i in range(len(dataset))}\n\n    for ci, fname in enumerate(filenames):\n        idx = name2idx[fname]\n        img_tensor, target, basename = dataset[idx]\n        img_pil = T.ToPILImage()(img_tensor)\n\n        # Model inference\n        inp = img_tensor.to(device)\n        out = model([inp])[0]\n\n        boxes_p = out[\"boxes\"].cpu().numpy()\n        scores_p = out[\"scores\"].cpu().numpy()\n        labels_p = out[\"labels\"].cpu().numpy()\n        keep = scores_p >= score_thresh\n        boxes_p, scores_p, labels_p = boxes_p[keep], scores_p[keep], labels_p[keep]\n\n        # Ground truth\n        boxes_g = target[\"boxes\"].numpy()\n        labels_g = target[\"labels\"].numpy()\n\n        # Predictions in red (with scores), ground truth in green\n        pred_vis = draw_boxes_pil(img_pil, boxes_p, labels_p, classes, scores=scores_p, color=\"red\")\n        gt_vis = draw_boxes_pil(img_pil, boxes_g, labels_g, classes, color=\"green\")\n\n        axes[0, ci].imshow(pred_vis); axes[0, ci].set_title(f\"Pred: {basename}\")\n        axes[0, ci].axis(\"off\")\n        axes[1, ci].imshow(gt_vis);   axes[1, ci].set_title(\"Ground Truth\")\n        axes[1, ci].axis(\"off\")\n\n    plt.tight_layout()\n    plt.show()\n\n\n# Visualise predictions vs ground truth for four test images\nfilenames = [\"40424.png\", \"41225.png\", \"62137.png\", \"45701.png\"]\n\nviz_pred_gt_fixed(model, test_set, CLASSES, filenames, score_thresh=0.3, device=device)","metadata":{"id":"vV_7uUzz6-E2","trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:24:01.516107Z","iopub.execute_input":"2026-10-11T15:24:01.516694Z","iopub.status.idle":"2026-10-11T15:24:03.300818Z","shell.execute_reply.started":"2026-10-11T15:24:01.516666Z","shell.execute_reply":"2026-10-11T15:24:03.299891Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x800 with 8 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":21},{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import confusion_matrix, roc_curve, auc\n\npreds_per_img = all_boxes[0]   # one array per test image: [x1, y1, x2, y2, score]\ngts_per_img = gt_boxes[0]      # one array per test image: [x1, y1, x2, y2]\n\nn_pred = sum(len(p) for p in preds_per_img)\nif n_pred == 0:\n    raise RuntimeError(\"No predictions loaded: run Step 4, then Step 5, before this cell.\")\n\n# ---------- 1 & 2: box-level FROC and precision-recall ----------\ntp_gt, sens, fp_per_img, precisions = FROC(preds_per_img, gts_per_img, iou_th=0.5)\n\nfig, ax = plt.subplots(1, 2, figsize=(13, 5))\n\nax[0].plot(fp_per_img, sens)\nfor fp in [0.05, 0.1, 0.2, 0.5]:\n    ax[0].axvline(fp, linestyle=\"--\", color=\"grey\", alpha=0.5)\nax[0].set_xlim(0, 2)\nax[0].set_ylim(0, 1)\nax[0].set_xlabel(\"Average false positives per image\")\nax[0].set_ylabel(\"Recall (sensitivity)\")\nax[0].set_title(\"FROC curve (IoU ≥ 0.5)\")\n\nax[1].plot(sens, precisions)\nax[1].set_xlim(0, 1)\nax[1].set_ylim(0, 1)\nax[1].set_xlabel(\"Recall\")\nax[1].set_ylabel(\"Precision\")\nax[1].set_title(\"Box-level precision-recall curve\")\nplt.tight_layout()\nplt.show()\n\nprint(f\"Maximum recall reached: {sens[-1]:.3f} \"\n      f\"({tp_gt[0]} of {tp_gt[1]} ground-truth boxes found)\")\n\n# ---------- 3: image-level confusion matrix and ROC ----------\ny_true = np.array([1 if len(g) > 0 else 0 for g in gts_per_img])\ny_score = np.array([p[:, 4].max() if len(p) else 0.0 for p in preds_per_img])\nIMG_THRESH = 0.5\ny_pred = (y_score >= IMG_THRESH).astype(int)\n\ncm = confusion_matrix(y_true, y_pred, labels=[0, 1])\ntn, fp, fn, tp = cm.ravel()\nprint(f\"\\nImage level (positive if any box ≥ {IMG_THRESH}):\")\nprint(f\"  Sensitivity: {tp / (tp + fn):.3f}   Specificity: {tn / (tn + fp):.3f}   \"\n      f\"Accuracy: {(tp + tn) / len(y_true):.3f}\")\n\nfpr, tpr, _ = roc_curve(y_true, y_score)\nimg_auc = auc(fpr, tpr)\n\nfig, ax = plt.subplots(1, 2, figsize=(12, 5))\nsns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", cbar=False,\n            xticklabels=[\"No consolidation\", \"Consolidation\"],\n            yticklabels=[\"No consolidation\", \"Consolidation\"], ax=ax[0])\nax[0].set_xlabel(\"Predicted\")\nax[0].set_ylabel(\"True\")\nax[0].set_title(\"Image-level confusion matrix\")\n\nax[1].plot(fpr, tpr, label=f\"AUC = {img_auc:.3f}\")\nax[1].plot([0, 1], [0, 1], linestyle=\"--\")\nax[1].set_xlabel(\"False positive rate\")\nax[1].set_ylabel(\"True positive rate\")\nax[1].set_title(\"Image-level ROC (max box score per image)\")\nax[1].legend(loc=\"lower right\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:24:12.692042Z","iopub.execute_input":"2026-10-11T15:24:12.692802Z","iopub.status.idle":"2026-10-11T15:24:13.538973Z","shell.execute_reply.started":"2026-10-11T15:24:12.692776Z","shell.execute_reply":"2026-10-11T15:24:13.538246Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1300x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Maximum recall reached: 0.806 (58 of 72 ground-truth boxes found)\n\nImage level (positive if any box ≥ 0.5):\n  Sensitivity: 0.762   Specificity: 0.867   Accuracy: 0.832\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":22},{"cell_type":"code","source":"# ---- Train vs Test confusion matrix (image-level, baseline Faster R-CNN) ----\nimport numpy as np\nimport torch\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import confusion_matrix\nfrom torch.utils.data import DataLoader\n\nIMG_THRESH = 0.5   # an image counts as \"consolidation\" if its top box score >= 0.5\n\n@torch.no_grad()\ndef collect_predictions_cm(model, dataset, score_thresh=0.02):\n    model.eval()\n    loader = DataLoader(dataset, batch_size=4, shuffle=False,\n                        num_workers=2, collate_fn=collate_fn)\n    preds, gts = [], []\n    for images, targets, _ in loader:\n        outputs = model([img.to(device) for img in images])\n        for out, tgt in zip(outputs, targets):\n            keep = (out[\"scores\"] >= score_thresh) & (out[\"labels\"] > 0)\n            b = out[\"boxes\"][keep].cpu().numpy()\n            s = out[\"scores\"][keep].cpu().numpy()\n            preds.append(np.hstack([b, s[:, None]]) if len(b) else np.zeros((0, 5)))\n            gts.append(tgt[\"boxes\"].numpy())\n    return preds, gts\n\ndef image_level(preds, gts, thresh=IMG_THRESH):\n    y_true = np.array([1 if len(g) > 0 else 0 for g in gts])\n    y_score = np.array([p[:, 4].max() if len(p) else 0.0 for p in preds])\n    return y_true, (y_score >= thresh).astype(int)\n\nfig, axes = plt.subplots(1, 2, figsize=(12, 5))\nfor ax, (name, ds) in zip(axes, [(\"Train\", train_set), (\"Test\", test_set)]):\n    preds, gts = collect_predictions_cm(model, ds)\n    y_true, y_pred = image_level(preds, gts)\n    cm = confusion_matrix(y_true, y_pred, labels=[0, 1])\n    tn, fp, fn, tp = cm.ravel()\n    acc  = (tp + tn) / cm.sum()\n    sens = tp / (tp + fn) if (tp + fn) else 0.0\n    spec = tn / (tn + fp) if (tn + fp) else 0.0\n\n    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", cbar=False, ax=ax,\n                xticklabels=[\"No consolidation\", \"Consolidation\"],\n                yticklabels=[\"No consolidation\", \"Consolidation\"])\n    ax.set_xlabel(\"Predicted\"); ax.set_ylabel(\"Actual\")\n    ax.set_title(f\"{name} set (n={len(ds)})\\n\"\n                 f\"Acc {acc:.3f} | Sens {sens:.3f} | Spec {spec:.3f}\")\n    print(f\"{name}: TN={tn} FP={fp} FN={fn} TP={tp} | \"\n          f\"Acc={acc:.3f} Sens={sens:.3f} Spec={spec:.3f}\")\n\nplt.suptitle(f\"Baseline Faster R-CNN, image-level confusion matrix (threshold {IMG_THRESH})\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:27:11.639127Z","iopub.execute_input":"2026-10-11T15:27:11.639513Z","iopub.status.idle":"2026-10-11T15:29:06.137891Z","shell.execute_reply.started":"2026-10-11T15:27:11.63948Z","shell.execute_reply":"2026-10-11T15:29:06.137271Z"}},"outputs":[{"name":"stdout","text":"Train: TN=593 FP=88 FN=55 TP=229 | Acc=0.852 Sens=0.806 Spec=0.871\nTest: TN=72 FP=11 FN=10 TP=32 | Acc=0.832 Sens=0.762 Spec=0.867\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":23},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport torch\nfrom tqdm import tqdm\nfrom torch.utils.data import DataLoader\n\n\n@torch.no_grad()\ndef collect_predictions(model, dataset, score_thresh=0.02):\n    \"\"\"Run the model over a dataset and return per-image predictions and ground truth.\"\"\"\n    loader = DataLoader(dataset, batch_size=4, shuffle=False, num_workers=2, collate_fn=collate_fn)\n    model.eval()\n    preds, gts = [], []\n    for images, targets, _ in tqdm(loader, desc=\"Predicting\"):\n        outputs = model([img.to(device) for img in images])\n        for out, t in zip(outputs, targets):\n            boxes = out[\"boxes\"].cpu().numpy()\n            scores = out[\"scores\"].cpu().numpy()\n            labels = out[\"labels\"].cpu().numpy()\n            keep = (scores >= score_thresh) & (labels > 0)\n            if keep.any():\n                preds.append(np.hstack([boxes[keep], scores[keep][:, None]]).astype(np.float32))\n            else:\n                preds.append(np.zeros((0, 5), dtype=np.float32))\n            gts.append(t[\"boxes\"].numpy().astype(np.float32))\n    return preds, gts\n\n\ndef summarise(preds, gts, fp_levels=(0.05, 0.1, 0.2, 0.5), img_thresh=0.5):\n    \"\"\"Box-level recall/precision at fixed FP per image, plus image-level accuracy.\"\"\"\n    result = {}\n\n    # Box level (same method as Step 5, IoU >= 0.5)\n    tp_gt, sens, fp_per_img, precisions = FROC(preds, gts, iou_th=0.5)\n    for fp in fp_levels:\n        if len(fp_per_img) > 1 and fp <= fp_per_img[-1]:\n            result[f\"Recall@{fp}\"] = float(np.interp(fp, fp_per_img, sens))\n            result[f\"Precision@{fp}\"] = float(np.interp(fp, fp_per_img, precisions))\n        else:\n            result[f\"Recall@{fp}\"] = np.nan\n            result[f\"Precision@{fp}\"] = np.nan\n    result[\"Max recall\"] = float(sens[-1]) if len(sens) else 0.0\n\n    # Image level: positive if the most confident box >= img_thresh\n    y_true = np.array([len(g) > 0 for g in gts], dtype=int)\n    y_score = np.array([p[:, 4].max() if len(p) else 0.0 for p in preds])\n    y_pred = (y_score >= img_thresh).astype(int)\n    tp = int(((y_pred == 1) & (y_true == 1)).sum())\n    tn = int(((y_pred == 0) & (y_true == 0)).sum())\n    fp = int(((y_pred == 1) & (y_true == 0)).sum())\n    fn = int(((y_pred == 0) & (y_true == 1)).sum())\n    result[\"Image accuracy\"] = (tp + tn) / len(y_true)\n    result[\"Image sensitivity\"] = tp / (tp + fn) if (tp + fn) else np.nan\n    result[\"Image specificity\"] = tn / (tn + fp) if (tn + fp) else np.nan\n\n    result[\"GT boxes\"] = sum(len(g) for g in gts)\n    result[\"Predicted boxes\"] = sum(len(p) for p in preds)\n    return result\n\n\ntrain_preds, train_gts = collect_predictions(model, train_set)\ntest_preds, test_gts = collect_predictions(model, test_set)\n\nresults = pd.DataFrame({\n    \"Train\": summarise(train_preds, train_gts),\n    \"Test\": summarise(test_preds, test_gts),\n})\nresults[\"Gap (Train − Test)\"] = results[\"Train\"] - results[\"Test\"]\ndisplay(results.round(4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:29:19.281871Z","iopub.execute_input":"2026-10-11T15:29:19.2826Z","iopub.status.idle":"2026-10-11T15:31:13.704463Z","shell.execute_reply.started":"2026-10-11T15:29:19.282569Z","shell.execute_reply":"2026-10-11T15:31:13.703575Z"}},"outputs":[{"name":"stderr","text":"Predicting: 100%|██████████| 242/242 [01:40<00:00,  2.40it/s]\nPredicting: 100%|██████████| 32/32 [00:13<00:00,  2.39it/s]\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                       Train      Test  Gap (Train − Test)\nRecall@0.05           0.3880    0.2917              0.0964\nPrecision@0.05        0.7839    0.7708              0.0130\nRecall@0.1            0.5211    0.3194              0.2016\nPrecision@0.1         0.7089    0.6480              0.0609\nRecall@0.2            0.6430    0.4861              0.1569\nPrecision@0.2         0.6004    0.5833              0.0171\nRecall@0.5            0.7206    0.5833              0.1373\nPrecision@0.5         0.4025    0.4019              0.0006\nMax recall            0.8803    0.8056              0.0747\nImage accuracy        0.8518    0.8320              0.0198\nImage sensitivity     0.8063    0.7619              0.0444\nImage specificity     0.8708    0.8675              0.0033\nGT boxes            451.0000   72.0000            379.0000\nPredicted boxes    3768.0000  599.0000           3169.0000","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Train</th>\n      <th>Test</th>\n      <th>Gap (Train − Test)</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Recall@0.05</th>\n      <td>0.3880</td>\n      <td>0.2917</td>\n      <td>0.0964</td>\n    </tr>\n    <tr>\n      <th>Precision@0.05</th>\n      <td>0.7839</td>\n      <td>0.7708</td>\n      <td>0.0130</td>\n    </tr>\n    <tr>\n      <th>Recall@0.1</th>\n      <td>0.5211</td>\n      <td>0.3194</td>\n      <td>0.2016</td>\n    </tr>\n    <tr>\n      <th>Precision@0.1</th>\n      <td>0.7089</td>\n      <td>0.6480</td>\n      <td>0.0609</td>\n    </tr>\n    <tr>\n      <th>Recall@0.2</th>\n      <td>0.6430</td>\n      <td>0.4861</td>\n      <td>0.1569</td>\n    </tr>\n    <tr>\n      <th>Precision@0.2</th>\n      <td>0.6004</td>\n      <td>0.5833</td>\n      <td>0.0171</td>\n    </tr>\n    <tr>\n      <th>Recall@0.5</th>\n      <td>0.7206</td>\n      <td>0.5833</td>\n      <td>0.1373</td>\n    </tr>\n    <tr>\n      <th>Precision@0.5</th>\n      <td>0.4025</td>\n      <td>0.4019</td>\n      <td>0.0006</td>\n    </tr>\n    <tr>\n      <th>Max recall</th>\n      <td>0.8803</td>\n      <td>0.8056</td>\n      <td>0.0747</td>\n    </tr>\n    <tr>\n      <th>Image accuracy</th>\n      <td>0.8518</td>\n      <td>0.8320</td>\n      <td>0.0198</td>\n    </tr>\n    <tr>\n      <th>Image sensitivity</th>\n      <td>0.8063</td>\n      <td>0.7619</td>\n      <td>0.0444</td>\n    </tr>\n    <tr>\n      <th>Image specificity</th>\n      <td>0.8708</td>\n      <td>0.8675</td>\n      <td>0.0033</td>\n    </tr>\n    <tr>\n      <th>GT boxes</th>\n      <td>451.0000</td>\n      <td>72.0000</td>\n      <td>379.0000</td>\n    </tr>\n    <tr>\n      <th>Predicted boxes</th>\n      <td>3768.0000</td>\n      <td>599.0000</td>\n      <td>3169.0000</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":24},{"cell_type":"markdown","source":"**Step 7: Optimization Research Experiment (6 points)**\n\nUsing the final Faster R-CNN from Steps 1–6 as the baseline, with its selected hyperparameters fixed, identify **one meaningful improvement opportunity**, analyze its possible cause, and design an experiment to address it.\n\n**Important:** Use the best hyperparameter settings obtained from Steps 1–6 and keep them fixed throughout this experiment. Hyperparameter tuning itself should not be considered an intervention.\n\n1. **Baseline diagnosis (1 point)**: Identify a specific issue in the baseline results and propose a possible cause.\n\n2. **Experiment design (1 point)**: Propose one intervention based on the cause. Change **one** main factor at a time while keeping the other important settings controlled.\n\n3. **Experiment (2 points)**: Implement the proposed experiment in code, run all the experiment including evaluation, and also save all required outputs and results in the notebook.\n\n4. **Analysis and Interpretation (2 points)**: Compare the modified model with the baseline using relevant evaluation metrics, and determine whether the intervention copes with the identified issue\n\n**Possible interventions** include, but are **not limited to**, modifying the detection loss function, hard-negative handling (e.g., foreground-background sampling), anchor design, data augmentation, or model architecture improvement. These are provided only as examples; other interventions are also acceptable.","metadata":{"id":"IVub5jbA7EIy"}},{"cell_type":"markdown","source":"**Yours:**\n1. **Baseline diagnosis**:","metadata":{"id":"w7zqEsyRj1vc"}},{"cell_type":"markdown","source":"2. **Experiment design**:","metadata":{"id":"GOOEWPPyj09Y"}},{"cell_type":"markdown","source":"3. **Experiment**:","metadata":{"id":"pVSJERydkD6p"}},{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom PIL import Image\n\n# Faster R-CNN resizes images internally (short side 800, long side at most 1333),\n# and anchors are defined in that resized space, so box sizes are measured there too.\nMIN_SIZE, MAX_SIZE = 800, 1333\n\n\ndef gt_box_shapes(dataset):\n    ws, hs = [], []\n    for img_path, it in dataset.items:\n        with Image.open(img_path) as im:\n            W, H = im.size\n        scale = min(MIN_SIZE / min(H, W), MAX_SIZE / max(H, W))\n        for s, b in zip(it.get(\"syms\", []), it.get(\"boxes\", [])):\n            if s not in CLS2ID:\n                continue\n            x1, y1, x2, y2 = b\n            w, h = (x2 - x1) * scale, (y2 - y1) * scale\n            if w > 0 and h > 0:\n                ws.append(w)\n                hs.append(h)\n    return np.array(ws), np.array(hs)\n\n\ndef anchor_shapes(sizes, ratios):\n    # torchvision convention: ratio = height / width, area = size^2\n    return [(s / np.sqrt(r), s * np.sqrt(r)) for s in sizes for r in ratios]\n\n\ndef best_anchor_iou(ws, hs, shapes):\n    # IoU between each GT box and its best-matching anchor shape (both centred at the same point)\n    best = np.zeros(len(ws))\n    for aw, ah in shapes:\n        inter = np.minimum(ws, aw) * np.minimum(hs, ah)\n        union = ws * hs + aw * ah - inter\n        best = np.maximum(best, inter / union)\n    return best\n\n\nws, hs = gt_box_shapes(train_set)\nbox_size = np.sqrt(ws * hs)   # comparable to an anchor \"size\"\nbox_ratio = hs / ws           # height / width\n\nprint(f\"Training consolidation boxes: {len(ws)}\")\nprint(f\"Width  (px): median {np.median(ws):.0f}, 5–95% range {np.percentile(ws, 5):.0f}–{np.percentile(ws, 95):.0f}\")\nprint(f\"Height (px): median {np.median(hs):.0f}, 5–95% range {np.percentile(hs, 5):.0f}–{np.percentile(hs, 95):.0f}\")\nprint(f\"Size √(w·h): median {np.median(box_size):.0f}, 5–95% range \"\n      f\"{np.percentile(box_size, 5):.0f}–{np.percentile(box_size, 95):.0f}\")\nprint(f\"Aspect ratio (h/w): median {np.median(box_ratio):.2f}, 10–90% range \"\n      f\"{np.percentile(box_ratio, 10):.2f}–{np.percentile(box_ratio, 90):.2f}\")\n\n# ---- Default anchors vs data-driven anchors ----\nDEFAULT_SIZES = (32, 64, 128, 256, 512)\nDEFAULT_RATIOS = (0.5, 1.0, 2.0)\n\n# One size per FPN level, taken from the spread of real box sizes;\n# three aspect ratios taken from the spread of real box shapes.\nPROPOSED_SIZES = tuple(int(round(np.percentile(box_size, p))) for p in (5, 25, 50, 75, 95))\nPROPOSED_RATIOS = tuple(round(float(np.percentile(box_ratio, p)), 2) for p in (10, 50, 90))\nprint(\"\\nDefault anchors : sizes\", DEFAULT_SIZES, \"| ratios\", DEFAULT_RATIOS)\nprint(\"Proposed anchors: sizes\", PROPOSED_SIZES, \"| ratios\", PROPOSED_RATIOS)\n\niou_default = best_anchor_iou(ws, hs, anchor_shapes(DEFAULT_SIZES, DEFAULT_RATIOS))\niou_proposed = best_anchor_iou(ws, hs, anchor_shapes(PROPOSED_SIZES, PROPOSED_RATIOS))\nfor name, iou in [(\"Default\", iou_default), (\"Proposed\", iou_proposed)]:\n    print(f\"{name:8s} anchors: mean best IoU {iou.mean():.3f} | \"\n          f\"boxes with an anchor IoU ≥ 0.7: {np.mean(iou >= 0.7):.1%} | ≥ 0.5: {np.mean(iou >= 0.5):.1%}\")\n\n# ---- Visuals ----\nfig, ax = plt.subplots(1, 3, figsize=(18, 5))\n\nax[0].scatter(ws, hs, s=8, alpha=0.4, label=\"Consolidation boxes\")\nd = np.array(anchor_shapes(DEFAULT_SIZES, DEFAULT_RATIOS))\np = np.array(anchor_shapes(PROPOSED_SIZES, PROPOSED_RATIOS))\nax[0].scatter(d[:, 0], d[:, 1], marker=\"x\", s=80, color=\"red\", label=\"Default anchors\")\nax[0].scatter(p[:, 0], p[:, 1], marker=\"^\", s=80, color=\"green\", label=\"Proposed anchors\")\nax[0].set_xscale(\"log\"); ax[0].set_yscale(\"log\")\nax[0].set_xlabel(\"Width (px, resized image)\"); ax[0].set_ylabel(\"Height (px, resized image)\")\nax[0].set_title(\"Ground-truth box shapes vs anchor shapes\")\nax[0].legend()\n\nax[1].hist(box_ratio, bins=40, alpha=0.7)\nfor r in DEFAULT_RATIOS:\n    ax[1].axvline(r, color=\"red\", linestyle=\"--\")\nfor r in PROPOSED_RATIOS:\n    ax[1].axvline(r, color=\"green\", linestyle=\"-\")\nax[1].set_xlabel(\"Aspect ratio (height / width)\"); ax[1].set_ylabel(\"Number of boxes\")\nax[1].set_title(\"Box aspect ratios (red = default, green = proposed)\")\n\nax[2].hist(iou_default, bins=30, alpha=0.6, color=\"red\", label=\"Default anchors\")\nax[2].hist(iou_proposed, bins=30, alpha=0.6, color=\"green\", label=\"Proposed anchors\")\nax[2].axvline(0.7, color=\"black\", linestyle=\"--\", label=\"RPN positive threshold (0.7)\")\nax[2].set_xlabel(\"Best anchor IoU per ground-truth box\"); ax[2].set_ylabel(\"Number of boxes\")\nax[2].set_title(\"How well anchors fit the real boxes\")\nax[2].legend()\n\nplt.tight_layout()\nplt.show()","metadata":{"id":"3wr56Kmqi6M9","trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:34:29.751972Z","iopub.execute_input":"2026-10-11T15:34:29.752493Z","iopub.status.idle":"2026-10-11T15:34:31.775661Z","shell.execute_reply.started":"2026-10-11T15:34:29.752462Z","shell.execute_reply":"2026-10-11T15:34:31.775068Z"}},"outputs":[{"name":"stdout","text":"Training consolidation boxes: 451\nWidth  (px): median 170, 5–95% range 85–252\nHeight (px): median 219, 5–95% range 79–529\nSize √(w·h): median 188, 5–95% range 92–345\nAspect ratio (h/w): median 1.38, 10–90% range 0.72–2.31\n\nDefault anchors : sizes (32, 64, 128, 256, 512) | ratios (0.5, 1.0, 2.0)\nProposed anchors: sizes (92, 144, 188, 253, 345) | ratios (0.72, 1.38, 2.31)\nDefault  anchors: mean best IoU 0.695 | boxes with an anchor IoU ≥ 0.7: 49.9% | ≥ 0.5: 100.0%\nProposed anchors: mean best IoU 0.799 | boxes with an anchor IoU ≥ 0.7: 90.5% | ≥ 0.5: 98.4%\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x500 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":25},{"cell_type":"code","source":"import os, json, random\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom tqdm import tqdm\nfrom torch.utils.data import DataLoader\nfrom torchvision.models.detection.rpn import AnchorGenerator\n\nEXP_EPOCHS = 5\nRETRAIN_BASELINE = (EXP_EPOCHS != 5)   # the saved baseline was trained for 5 epochs\n\n\ndef set_seed(seed=42):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n\n\ndef build_model(anchor_sizes=None, aspect_ratios=None):\n    \"\"\"Same Faster R-CNN as Step 2; optionally with custom anchors (the only change).\"\"\"\n    kwargs = {}\n    if anchor_sizes is not None:\n        kwargs[\"rpn_anchor_generator\"] = AnchorGenerator(\n            sizes=tuple((s,) for s in anchor_sizes),            # one size per FPN level\n            aspect_ratios=(tuple(aspect_ratios),) * len(anchor_sizes),\n        )\n    return fasterrcnn_resnet50_fpn(pretrained_backbone=True,\n                                   num_classes=len(CLASSES) + 1, **kwargs).to(device)\n\n\ndef train_one_epoch(model, optimizer, data_loader, device):\n    model.train()\n    total = 0.0\n    pbar = tqdm(data_loader)\n    for images, targets, _ in pbar:\n        images = [img.to(device) for img in images]\n        targets = [{k: v.to(device) for k, v in t.items()} for t in targets]\n        losses = sum(model(images, targets).values())\n        optimizer.zero_grad()\n        losses.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        optimizer.step()\n        total += losses.item()\n        pbar.set_postfix(loss=losses.item())\n    return total / len(data_loader)\n\n\ndef train_detector(model, epochs, tag):\n    \"\"\"Identical optimiser and schedule to Step 3: AdamW 5e-5, weight decay 1e-4, cosine decay.\"\"\"\n    params = [p for p in model.parameters() if p.requires_grad]\n    optimizer = torch.optim.AdamW(params, lr=0.00005, weight_decay=1e-4)\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs, eta_min=1e-6)\n    losses = []\n    for ep in range(epochs):\n        avg = train_one_epoch(model, optimizer, train_loader, device)\n        losses.append(avg)\n        print(f\"[{tag}] epoch {ep + 1}/{epochs}: loss {avg:.4f}, lr {optimizer.param_groups[0]['lr']:.2e}\")\n        scheduler.step()\n    torch.save(model.state_dict(), f\"{OUT_DIR}/{tag}.pth\")\n    return model, losses\n\n\n@torch.no_grad()\ndef write_predictions(model, pred_dir, score_thresh=0.02):\n    \"\"\"Same as Step 4: one JSON file per test image.\"\"\"\n    model.eval()\n    os.makedirs(pred_dir, exist_ok=True)\n    for images, _, names in tqdm(test_loader, desc=f\"Predicting -> {os.path.basename(pred_dir)}\"):\n        outputs = model([img.to(device) for img in images])\n        for name, out in zip(names, outputs):\n            per_image = []\n            for (x1, y1, x2, y2), sc, lb in zip(out[\"boxes\"].cpu().numpy(),\n                                                 out[\"scores\"].cpu().numpy(),\n                                                 out[\"labels\"].cpu().numpy()):\n                if sc >= score_thresh and lb > 0:\n                    per_image.append({CLASSES[lb - 1]: [float(x1), float(y1), float(x2), float(y2), float(sc)]})\n            with open(os.path.join(pred_dir, os.path.splitext(name)[0] + \".json\"), \"w\") as f:\n                json.dump(per_image, f)\n\n\ndef evaluate_official(pred_dir):\n    \"\"\"Same as Step 5 (the assignment's evaluation).\"\"\"\n    gt_b, file_ids = get_gt_info(BASE + \"/test.json\", CLASSES)\n    all_b = get_pred_info(pred_dir, file_ids, CLASSES)\n    eval_FROC(gt_b, all_b, CLASSES)\n    return gt_b[0], all_b[0]\n\n\n@torch.no_grad()\ndef collect_predictions(model, dataset, score_thresh=0.02):\n    loader = DataLoader(dataset, batch_size=4, shuffle=False, num_workers=2, collate_fn=collate_fn)\n    model.eval()\n    preds, gts = [], []\n    for images, targets, _ in tqdm(loader, desc=\"Collecting\"):\n        for out, t in zip(model([img.to(device) for img in images]), targets):\n            b, s, l = out[\"boxes\"].cpu().numpy(), out[\"scores\"].cpu().numpy(), out[\"labels\"].cpu().numpy()\n            keep = (s >= score_thresh) & (l > 0)\n            preds.append(np.hstack([b[keep], s[keep][:, None]]).astype(np.float32)\n                         if keep.any() else np.zeros((0, 5), dtype=np.float32))\n            gts.append(t[\"boxes\"].numpy().astype(np.float32))\n    return preds, gts\n\n\ndef summarise(preds, gts, fp_levels=(0.05, 0.1, 0.2, 0.5), img_thresh=0.5):\n    r = {}\n    tp_gt, sens, fpi, prec = FROC(preds, gts, iou_th=0.5)\n    for fp in fp_levels:\n        ok = len(fpi) > 1 and fp <= fpi[-1]\n        r[f\"Recall@{fp}\"] = float(np.interp(fp, fpi, sens)) if ok else np.nan\n        r[f\"Precision@{fp}\"] = float(np.interp(fp, fpi, prec)) if ok else np.nan\n    r[\"Max recall\"] = float(sens[-1]) if len(sens) else 0.0\n    y_true = np.array([len(g) > 0 for g in gts], dtype=int)\n    y_score = np.array([p[:, 4].max() if len(p) else 0.0 for p in preds])\n    y_pred = (y_score >= img_thresh).astype(int)\n    tp = int(((y_pred == 1) & (y_true == 1)).sum()); tn = int(((y_pred == 0) & (y_true == 0)).sum())\n    fp_ = int(((y_pred == 1) & (y_true == 0)).sum()); fn = int(((y_pred == 0) & (y_true == 1)).sum())\n    r[\"Image accuracy\"] = (tp + tn) / len(y_true)\n    r[\"Image sensitivity\"] = tp / (tp + fn) if (tp + fn) else np.nan\n    r[\"Image specificity\"] = tn / (tn + fp_) if (tn + fp_) else np.nan\n    r[\"Predicted boxes\"] = sum(len(p) for p in preds)\n    r[\"Predicted boxes per image\"] = r[\"Predicted boxes\"] / len(preds)\n    return r\n\n\nprint(f\"Epochs: {EXP_EPOCHS} | retrain baseline: {RETRAIN_BASELINE}\")\nprint(\"Proposed anchors: sizes\", PROPOSED_SIZES, \"| ratios\", PROPOSED_RATIOS)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:34:40.95479Z","iopub.execute_input":"2026-10-11T15:34:40.955195Z","iopub.status.idle":"2026-10-11T15:34:40.980934Z","shell.execute_reply.started":"2026-10-11T15:34:40.955169Z","shell.execute_reply":"2026-10-11T15:34:40.980251Z"}},"outputs":[{"name":"stdout","text":"Epochs: 5 | retrain baseline: False\nProposed anchors: sizes (92, 144, 188, 253, 345) | ratios (0.72, 1.38, 2.31)\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"import torch\n\n# Free GPU memory used by the Step 3 model\nif \"model\" in globals():\n    model.to(\"cpu\")\ntorch.cuda.empty_cache()\n\n# ---- Baseline (default anchors) ----\nif RETRAIN_BASELINE:\n    set_seed(42)\n    model_base = build_model()\n    model_base, loss_base = train_detector(model_base, EXP_EPOCHS, f\"frcnn_baseline_{EXP_EPOCHS}ep\")\nelse:\n    model_base = build_model()\n    model_base.load_state_dict(torch.load(f\"{OUT_DIR}/fasterrcnn_chestxdet10.pth\", map_location=device))\n    loss_base = loss_history   # from Step 3\n    print(\"Loaded the 5-epoch baseline from Step 3\")\n\n# ---- Data-driven anchors (the only change) ----\nset_seed(42)\nmodel_anchor = build_model(PROPOSED_SIZES, PROPOSED_RATIOS)\nmodel_anchor, loss_anchor = train_detector(model_anchor, EXP_EPOCHS, f\"frcnn_anchors_{EXP_EPOCHS}ep\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T15:51:24.113447Z","iopub.execute_input":"2026-10-11T15:51:24.113718Z","iopub.status.idle":"2026-10-11T16:09:37.857412Z","shell.execute_reply.started":"2026-10-11T15:51:24.113695Z","shell.execute_reply":"2026-10-11T16:09:37.856587Z"}},"outputs":[{"name":"stdout","text":"Loaded the 5-epoch baseline from Step 3\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.0548] \n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_5ep] epoch 1/5: loss 0.2970, lr 5.00e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.0499] \n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_5ep] epoch 2/5: loss 0.2462, lr 4.53e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.0482]  \n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_5ep] epoch 3/5: loss 0.2080, lr 3.31e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.00858]\n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_5ep] epoch 4/5: loss 0.1793, lr 1.79e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.00232]\n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_5ep] epoch 5/5: loss 0.1481, lr 5.68e-06\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nPRED_BASE = f\"{OUT_DIR}/pred_json_baseline_{EXP_EPOCHS}ep\"\nPRED_ANCHOR = f\"{OUT_DIR}/pred_json_anchors_{EXP_EPOCHS}ep\"\n\nwrite_predictions(model_base, PRED_BASE)\nwrite_predictions(model_anchor, PRED_ANCHOR)\nprint(\"\\n##### Baseline (default anchors) #####\")\nevaluate_official(PRED_BASE)\nprint(\"\\n##### Data-driven anchors #####\")\nevaluate_official(PRED_ANCHOR)\n\n# ---- Full comparison, test and train ----\ntest_base = collect_predictions(model_base, test_set)\ntest_anchor = collect_predictions(model_anchor, test_set)\ntrain_base = collect_predictions(model_base, train_set)\ntrain_anchor = collect_predictions(model_anchor, train_set)\n\ncomparison = pd.DataFrame({\n    \"Baseline (test)\": summarise(*test_base),\n    \"Anchors (test)\": summarise(*test_anchor),\n})\ncomparison[\"Change (test)\"] = comparison[\"Anchors (test)\"] - comparison[\"Baseline (test)\"]\ncomparison[\"Baseline (train)\"] = pd.Series(summarise(*train_base))\ncomparison[\"Anchors (train)\"] = pd.Series(summarise(*train_anchor))\nprint(\"\\nComparison (IoU ≥ 0.5):\")\ndisplay(comparison.round(4))\n\n# ---- FROC overlay and loss curves ----\nfig, ax = plt.subplots(1, 3, figsize=(19, 5))\n\nfor name, (preds, gts), color in [(\"Baseline\", test_base, \"tab:blue\"),\n                                  (\"Data-driven anchors\", test_anchor, \"tab:green\")]:\n    _, sens, fpi, prec = FROC(preds, gts, iou_th=0.5)\n    ax[0].plot(fpi, sens, label=name, color=color)\n    ax[1].plot(sens, prec, label=name, color=color)\nfor fp in [0.05, 0.1, 0.2, 0.5]:\n    ax[0].axvline(fp, linestyle=\"--\", color=\"grey\", alpha=0.4)\nax[0].set_xlim(0, 2); ax[0].set_ylim(0, 1)\nax[0].set_xlabel(\"Average false positives per image\"); ax[0].set_ylabel(\"Recall\")\nax[0].set_title(\"FROC curve (test set)\"); ax[0].legend()\n\nax[1].set_xlim(0, 1); ax[1].set_ylim(0, 1)\nax[1].set_xlabel(\"Recall\"); ax[1].set_ylabel(\"Precision\")\nax[1].set_title(\"Box-level precision-recall (test set)\"); ax[1].legend()\n\nepochs = range(1, len(loss_anchor) + 1)\nax[2].plot(range(1, len(loss_base) + 1), loss_base, marker=\"o\", label=\"Baseline\")\nax[2].plot(epochs, loss_anchor, marker=\"o\", label=\"Data-driven anchors\")\nax[2].set_xlabel(\"Epoch\"); ax[2].set_ylabel(\"Average training loss\")\nax[2].set_title(\"Training loss\"); ax[2].legend()\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T16:16:32.47114Z","iopub.execute_input":"2026-10-11T16:16:32.471628Z","iopub.status.idle":"2026-10-11T16:20:48.362126Z","shell.execute_reply.started":"2026-10-11T16:16:32.471598Z","shell.execute_reply":"2026-10-11T16:20:48.361439Z"}},"outputs":[{"name":"stderr","text":"Predicting -> pred_json_baseline_5ep: 100%|██████████| 32/32 [00:13<00:00,  2.41it/s]\nPredicting -> pred_json_anchors_5ep: 100%|██████████| 32/32 [00:13<00:00,  2.30it/s]\n","output_type":"stream"},{"name":"stdout","text":"\n##### Baseline (default anchors) #####\n==================== Recall & Precision ====================\nRecall@0.05=29.17%, Precision@0.05=77.08%\nRecall@0.10=31.94%, Precision@0.10=64.80%\nRecall@0.20=48.61%, Precision@0.20=58.33%\nRecall@0.50=58.33%, Precision@0.50=40.19%\n\n##### Data-driven anchors #####\n==================== Recall & Precision ====================\nRecall@0.05=20.83%, Precision@0.05=70.62%\nRecall@0.10=36.11%, Precision@0.10=67.54%\nRecall@0.20=38.89%, Precision@0.20=52.83%\nRecall@0.50=58.33%, Precision@0.50=40.19%\n","output_type":"stream"},{"name":"stderr","text":"Collecting: 100%|██████████| 32/32 [00:13<00:00,  2.30it/s]\nCollecting: 100%|██████████| 32/32 [00:13<00:00,  2.40it/s]\nCollecting: 100%|██████████| 242/242 [01:40<00:00,  2.41it/s]\nCollecting: 100%|██████████| 242/242 [01:40<00:00,  2.41it/s]\n","output_type":"stream"},{"name":"stdout","text":"\nComparison (IoU ≥ 0.5):\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                           Baseline (test)  Anchors (test)  Change (test)  \\\nRecall@0.05                         0.2917          0.2083        -0.0833   \nPrecision@0.05                      0.7708          0.7062        -0.0647   \nRecall@0.1                          0.3194          0.3611         0.0417   \nPrecision@0.1                       0.6480          0.6754         0.0274   \nRecall@0.2                          0.4861          0.4028        -0.0833   \nPrecision@0.2                       0.5833          0.5370        -0.0463   \nRecall@0.5                          0.5833          0.5833         0.0000   \nPrecision@0.5                       0.4019          0.4019         0.0000   \nMax recall                          0.8056          0.7639        -0.0417   \nImage accuracy                      0.8320          0.7920        -0.0400   \nImage sensitivity                   0.7619          0.7619         0.0000   \nImage specificity                   0.8675          0.8072        -0.0602   \nPredicted boxes                   599.0000        392.0000      -207.0000   \nPredicted boxes per image           4.7920          3.1360        -1.6560   \n\n                           Baseline (train)  Anchors (train)  \nRecall@0.05                          0.3880           0.4368  \nPrecision@0.05                       0.7839           0.8033  \nRecall@0.1                           0.5211           0.5632  \nPrecision@0.1                        0.7089           0.7247  \nRecall@0.2                           0.6430           0.6896  \nPrecision@0.2                        0.6004           0.6171  \nRecall@0.5                           0.7206           0.7827  \nPrecision@0.5                        0.4025           0.4225  \nMax recall                           0.8803           0.9024  \nImage accuracy                       0.8518           0.8684  \nImage sensitivity                    0.8063           0.8873  \nImage specificity                    0.8708           0.8605  \nPredicted boxes                   3768.0000        2635.0000  \nPredicted boxes per image            3.9047           2.7306  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Baseline (test)</th>\n      <th>Anchors (test)</th>\n      <th>Change (test)</th>\n      <th>Baseline (train)</th>\n      <th>Anchors (train)</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Recall@0.05</th>\n      <td>0.2917</td>\n      <td>0.2083</td>\n      <td>-0.0833</td>\n      <td>0.3880</td>\n      <td>0.4368</td>\n    </tr>\n    <tr>\n      <th>Precision@0.05</th>\n      <td>0.7708</td>\n      <td>0.7062</td>\n      <td>-0.0647</td>\n      <td>0.7839</td>\n      <td>0.8033</td>\n    </tr>\n    <tr>\n      <th>Recall@0.1</th>\n      <td>0.3194</td>\n      <td>0.3611</td>\n      <td>0.0417</td>\n      <td>0.5211</td>\n      <td>0.5632</td>\n    </tr>\n    <tr>\n      <th>Precision@0.1</th>\n      <td>0.6480</td>\n      <td>0.6754</td>\n      <td>0.0274</td>\n      <td>0.7089</td>\n      <td>0.7247</td>\n    </tr>\n    <tr>\n      <th>Recall@0.2</th>\n      <td>0.4861</td>\n      <td>0.4028</td>\n      <td>-0.0833</td>\n      <td>0.6430</td>\n      <td>0.6896</td>\n    </tr>\n    <tr>\n      <th>Precision@0.2</th>\n      <td>0.5833</td>\n      <td>0.5370</td>\n      <td>-0.0463</td>\n      <td>0.6004</td>\n      <td>0.6171</td>\n    </tr>\n    <tr>\n      <th>Recall@0.5</th>\n      <td>0.5833</td>\n      <td>0.5833</td>\n      <td>0.0000</td>\n      <td>0.7206</td>\n      <td>0.7827</td>\n    </tr>\n    <tr>\n      <th>Precision@0.5</th>\n      <td>0.4019</td>\n      <td>0.4019</td>\n      <td>0.0000</td>\n      <td>0.4025</td>\n      <td>0.4225</td>\n    </tr>\n    <tr>\n      <th>Max recall</th>\n      <td>0.8056</td>\n      <td>0.7639</td>\n      <td>-0.0417</td>\n      <td>0.8803</td>\n      <td>0.9024</td>\n    </tr>\n    <tr>\n      <th>Image accuracy</th>\n      <td>0.8320</td>\n      <td>0.7920</td>\n      <td>-0.0400</td>\n      <td>0.8518</td>\n      <td>0.8684</td>\n    </tr>\n    <tr>\n      <th>Image sensitivity</th>\n      <td>0.7619</td>\n      <td>0.7619</td>\n      <td>0.0000</td>\n      <td>0.8063</td>\n      <td>0.8873</td>\n    </tr>\n    <tr>\n      <th>Image specificity</th>\n      <td>0.8675</td>\n      <td>0.8072</td>\n      <td>-0.0602</td>\n      <td>0.8708</td>\n      <td>0.8605</td>\n    </tr>\n    <tr>\n      <th>Predicted boxes</th>\n      <td>599.0000</td>\n      <td>392.0000</td>\n      <td>-207.0000</td>\n      <td>3768.0000</td>\n      <td>2635.0000</td>\n    </tr>\n    <tr>\n      <th>Predicted boxes per image</th>\n      <td>4.7920</td>\n      <td>3.1360</td>\n      <td>-1.6560</td>\n      <td>3.9047</td>\n      <td>2.7306</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1900x500 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":29},{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import confusion_matrix\n\nIMG_THRESH = 0.5\nLABELS = [\"No consolidation\", \"Consolidation\"]\n\ndef image_cm(preds, gts, thresh=IMG_THRESH):\n    y_true = np.array([1 if len(g) > 0 else 0 for g in gts])\n    y_score = np.array([p[:, 4].max() if len(p) else 0.0 for p in preds])\n    y_pred = (y_score >= thresh).astype(int)\n    cm = confusion_matrix(y_true, y_pred, labels=[0, 1])\n    tn, fp, fn, tp = cm.ravel()\n    stats = {\"Accuracy\": (tp + tn) / cm.sum(),\n             \"Sensitivity\": tp / (tp + fn) if (tp + fn) else 0.0,\n             \"Specificity\": tn / (tn + fp) if (tn + fp) else 0.0,\n             \"Precision\": tp / (tp + fp) if (tp + fp) else 0.0}\n    return cm, stats\n\ndef plot_train_test_cm(train_pg, test_pg, model_name, cmap=\"Blues\"):\n    fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n    for ax, (split, pg) in zip(axes, [(\"Train\", train_pg), (\"Test\", test_pg)]):\n        cm, s = image_cm(*pg)\n        sns.heatmap(cm, annot=True, fmt=\"d\", cmap=cmap, cbar=False, ax=ax,\n                    xticklabels=LABELS, yticklabels=LABELS)\n        ax.set_xlabel(\"Predicted\"); ax.set_ylabel(\"Actual\")\n        ax.set_title(f\"{split} (n={cm.sum()})\\nAcc {s['Accuracy']:.3f} | \"\n                     f\"Sens {s['Sensitivity']:.3f} | Spec {s['Specificity']:.3f}\")\n        print(f\"{model_name} [{split}] TN={cm[0,0]} FP={cm[0,1]} FN={cm[1,0]} TP={cm[1,1]} | \"\n              + \" \".join(f\"{k}={v:.3f}\" for k, v in s.items()))\n    plt.suptitle(f\"{model_name}: image-level confusion matrix (threshold {IMG_THRESH})\")\n    plt.tight_layout(); plt.show()\n\nplot_train_test_cm(train_anchor, test_anchor, \"Experiment 1: Faster R-CNN + Data-driven Anchors\", cmap=\"Greens\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T16:21:45.784604Z","iopub.execute_input":"2026-10-11T16:21:45.785485Z","iopub.status.idle":"2026-10-11T16:21:46.003581Z","shell.execute_reply.started":"2026-10-11T16:21:45.785445Z","shell.execute_reply":"2026-10-11T16:21:46.002968Z"}},"outputs":[{"name":"stdout","text":"Experiment 1: Faster R-CNN + Data-driven Anchors [Train] TN=586 FP=95 FN=32 TP=252 | Accuracy=0.868 Sensitivity=0.887 Specificity=0.860 Precision=0.726\nExperiment 1: Faster R-CNN + Data-driven Anchors [Test] TN=67 FP=16 FN=10 TP=32 | Accuracy=0.792 Sensitivity=0.762 Specificity=0.807 Precision=0.667\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":30},{"cell_type":"code","source":"import numpy as np\nimport matplotlib.pyplot as plt\nimport torch\nimport torchvision.transforms as T\n\n\n@torch.no_grad()\ndef compare_predictions(models, dataset, filenames, score_thresh=0.3):\n    name2idx = {os.path.basename(it[\"file_name\"]): i for i, (_, it) in enumerate(dataset.items)}\n    rows = len(models) + 1\n    fig, axes = plt.subplots(rows, len(filenames), figsize=(4 * len(filenames), 4 * rows))\n\n    for ci, fname in enumerate(filenames):\n        img_tensor, target, _ = dataset[name2idx[fname]]\n        img_pil = T.ToPILImage()(img_tensor)\n\n        for ri, (label, m) in enumerate(models.items()):\n            m.eval()\n            out = m([img_tensor.to(device)])[0]\n            keep = out[\"scores\"].cpu().numpy() >= score_thresh\n            vis = draw_boxes_pil(img_pil, out[\"boxes\"].cpu().numpy()[keep], out[\"labels\"].cpu().numpy()[keep],\n                                 CLASSES, scores=out[\"scores\"].cpu().numpy()[keep], color=\"red\")\n            axes[ri, ci].imshow(vis)\n            axes[ri, ci].set_title(f\"{label}: {fname} ({int(keep.sum())} boxes)\")\n            axes[ri, ci].axis(\"off\")\n\n        gt_vis = draw_boxes_pil(img_pil, target[\"boxes\"].numpy(), target[\"labels\"].numpy(), CLASSES, color=\"green\")\n        axes[-1, ci].imshow(gt_vis)\n        axes[-1, ci].set_title(f\"Ground truth ({len(target['boxes'])} boxes)\")\n        axes[-1, ci].axis(\"off\")\n\n    plt.tight_layout()\n    plt.show()\n\n\ncompare_predictions({\"Baseline\": model_base, \"Anchors\": model_anchor},\n                    test_set, [\"40424.png\", \"41225.png\", \"62137.png\", \"45701.png\"])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T16:21:53.156444Z","iopub.execute_input":"2026-10-11T16:21:53.15719Z","iopub.status.idle":"2026-10-11T16:21:55.734838Z","shell.execute_reply.started":"2026-10-11T16:21:53.157164Z","shell.execute_reply":"2026-10-11T16:21:55.733888Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x1200 with 12 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":31},{"cell_type":"markdown","source":"4. **Analysis and Interpretation**:","metadata":{"id":"x-H7lwo1j3p1"}},{"cell_type":"markdown","source":"EXPERIMENT 2\n","metadata":{}},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom collections import Counter\n\n# ---- Other abnormalities in the annotations? ----\nfor split in (\"train\", \"test\"):\n    ann = json.load(open(f\"{BASE}/{split}.json\"))\n    counts = Counter(s for a in ann for s in a.get(\"syms\", []))\n    n_empty = sum(1 for a in ann if not a.get(\"syms\"))\n    print(f\"{split}: labels {dict(counts)} | images with no labels: {n_empty} of {len(ann)}\")\n\n\ndef iou_matrix(a, b):\n    \"\"\"IoU between every box in a [N,4] and every box in b [M,4] (inclusive pixel coords).\"\"\"\n    if len(a) == 0 or len(b) == 0:\n        return np.zeros((len(a), len(b)))\n    ix1 = np.maximum(a[:, None, 0], b[None, :, 0]); iy1 = np.maximum(a[:, None, 1], b[None, :, 1])\n    ix2 = np.minimum(a[:, None, 2], b[None, :, 2]); iy2 = np.minimum(a[:, None, 3], b[None, :, 3])\n    inter = np.clip(ix2 - ix1 + 1, 0, None) * np.clip(iy2 - iy1 + 1, 0, None)\n    area_a = (a[:, 2] - a[:, 0] + 1) * (a[:, 3] - a[:, 1] + 1)\n    area_b = (b[:, 2] - b[:, 0] + 1) * (b[:, 3] - b[:, 1] + 1)\n    return inter / (area_a[:, None] + area_b[None, :] - inter)\n\n\ndef containment(a, b):\n    \"\"\"Fraction of each box in a that lies inside each box in b.\"\"\"\n    if len(a) == 0 or len(b) == 0:\n        return np.zeros((len(a), len(b)))\n    ix1 = np.maximum(a[:, None, 0], b[None, :, 0]); iy1 = np.maximum(a[:, None, 1], b[None, :, 1])\n    ix2 = np.minimum(a[:, None, 2], b[None, :, 2]); iy2 = np.minimum(a[:, None, 3], b[None, :, 3])\n    inter = np.clip(ix2 - ix1 + 1, 0, None) * np.clip(iy2 - iy1 + 1, 0, None)\n    area_a = (a[:, 2] - a[:, 0] + 1) * (a[:, 3] - a[:, 1] + 1)\n    return inter / area_a[:, None]\n\n\ndef other_disease_boxes(item):\n    syms, boxes = item.get(\"syms\", []), item.get(\"boxes\", [])\n    other = [b for s, b in zip(syms, boxes) if s not in CLS2ID]\n    return np.array(other, dtype=np.float32).reshape(-1, 4)\n\n\ndef classify_errors(preds, gts, dataset):\n    \"\"\"Label every predicted box, processing each image from highest to lowest score.\"\"\"\n    rows = []\n    for i, (p, g) in enumerate(zip(preds, gts)):\n        if len(p) == 0:\n            continue\n        p = p[np.argsort(-p[:, 4])]\n        other = other_disease_boxes(dataset.items[i][1])\n        ious = iou_matrix(p[:, :4], g)\n        contain = containment(p[:, :4], p[:, :4])\n        matched = np.zeros(len(g), dtype=bool)\n        for k in range(len(p)):\n            score = p[k, 4]\n            best = ious[k].argmax() if len(g) else -1\n            best_iou = ious[k, best] if len(g) else 0.0\n            if best_iou >= 0.5 and not matched[best]:\n                matched[best] = True\n                cat = \"Correct\"\n            elif best_iou >= 0.5:\n                cat = \"Duplicate of a found finding\"\n            elif k > 0 and contain[k, :k].max() >= 0.8:\n                cat = \"Nested inside a higher-scoring box\"\n            elif best_iou >= 0.1:\n                cat = \"Poor localisation (0.1 ≤ IoU < 0.5)\"\n            elif len(other) and max(iou_matrix(p[k:k+1, :4], other).max(),\n                                   containment(p[k:k+1, :4], other).max()) >= 0.3:\n                cat = \"Other abnormality (not consolidation)\"\n            elif len(g):\n                cat = \"Background, on an image with consolidation\"\n            else:\n                cat = \"Background, on an image with no consolidation\"\n            rows.append({\"image\": i, \"score\": score, \"category\": cat})\n    return pd.DataFrame(rows)\n\n\nerr_base = classify_errors(*test_base, test_set)\nerr_anchor = classify_errors(*test_anchor, test_set)\n\nfor name, df in [(\"Baseline\", err_base), (\"Data-driven anchors\", err_anchor)]:\n    table = pd.DataFrame({\n        \"All boxes (≥0.02)\": df[\"category\"].value_counts(),\n        \"Confident boxes (≥0.5)\": df[df[\"score\"] >= 0.5][\"category\"].value_counts(),\n    }).fillna(0).astype(int)\n    print(f\"\\n===== {name}: what each predicted box is =====\")\n    display(table)\n\n# ---- Score distributions: correct boxes vs false alarms ----\nfig, ax = plt.subplots(1, 2, figsize=(14, 4.5))\nfor a, (name, df) in zip(ax, [(\"Baseline\", err_base), (\"Data-driven anchors\", err_anchor)]):\n    for cat, color in [(\"Correct\", \"green\"),\n                       (\"Background, on an image with no consolidation\", \"red\"),\n                       (\"Background, on an image with consolidation\", \"orange\"),\n                       (\"Duplicate of a found finding\", \"purple\"),\n                       (\"Nested inside a higher-scoring box\", \"brown\")]:\n        s = df[df[\"category\"] == cat][\"score\"]\n        if len(s):\n            a.hist(s, bins=20, range=(0, 1), alpha=0.5, color=color, label=f\"{cat} ({len(s)})\")\n    a.set_xlabel(\"Confidence score\")\n    a.set_ylabel(\"Number of boxes\")\n    a.set_title(f\"{name}: score of correct vs false boxes\")\n    a.legend(fontsize=7)\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T16:22:18.457146Z","iopub.execute_input":"2026-10-11T16:22:18.457602Z","iopub.status.idle":"2026-10-11T16:22:19.090494Z","shell.execute_reply.started":"2026-10-11T16:22:18.457577Z","shell.execute_reply":"2026-10-11T16:22:19.089886Z"}},"outputs":[{"name":"stdout","text":"train: labels {'Consolidation': 451} | images with no labels: 681 of 965\ntest: labels {'Consolidation': 72} | images with no labels: 83 of 125\n\n===== Baseline: what each predicted box is =====\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                                               All boxes (≥0.02)  \\\ncategory                                                           \nBackground, on an image with consolidation                    41   \nBackground, on an image with no consolidation                131   \nCorrect                                                       58   \nDuplicate of a found finding                                  41   \nNested inside a higher-scoring box                           271   \nPoor localisation (0.1 ≤ IoU < 0.5)                           57   \n\n                                               Confident boxes (≥0.5)  \ncategory                                                               \nBackground, on an image with consolidation                          4  \nBackground, on an image with no consolidation                      16  \nCorrect                                                            42  \nDuplicate of a found finding                                        5  \nNested inside a higher-scoring box                                 17  \nPoor localisation (0.1 ≤ IoU < 0.5)                                12  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>All boxes (≥0.02)</th>\n      <th>Confident boxes (≥0.5)</th>\n    </tr>\n    <tr>\n      <th>category</th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Background, on an image with consolidation</th>\n      <td>41</td>\n      <td>4</td>\n    </tr>\n    <tr>\n      <th>Background, on an image with no consolidation</th>\n      <td>131</td>\n      <td>16</td>\n    </tr>\n    <tr>\n      <th>Correct</th>\n      <td>58</td>\n      <td>42</td>\n    </tr>\n    <tr>\n      <th>Duplicate of a found finding</th>\n      <td>41</td>\n      <td>5</td>\n    </tr>\n    <tr>\n      <th>Nested inside a higher-scoring box</th>\n      <td>271</td>\n      <td>17</td>\n    </tr>\n    <tr>\n      <th>Poor localisation (0.1 ≤ IoU &lt; 0.5)</th>\n      <td>57</td>\n      <td>12</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n===== Data-driven anchors: what each predicted box is =====\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                                               All boxes (≥0.02)  \\\ncategory                                                           \nBackground, on an image with consolidation                    16   \nBackground, on an image with no consolidation                109   \nCorrect                                                       55   \nDuplicate of a found finding                                  20   \nNested inside a higher-scoring box                           150   \nPoor localisation (0.1 ≤ IoU < 0.5)                           42   \n\n                                               Confident boxes (≥0.5)  \ncategory                                                               \nBackground, on an image with consolidation                          4  \nBackground, on an image with no consolidation                      20  \nCorrect                                                            42  \nDuplicate of a found finding                                        4  \nNested inside a higher-scoring box                                 21  \nPoor localisation (0.1 ≤ IoU < 0.5)                                14  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>All boxes (≥0.02)</th>\n      <th>Confident boxes (≥0.5)</th>\n    </tr>\n    <tr>\n      <th>category</th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Background, on an image with consolidation</th>\n      <td>16</td>\n      <td>4</td>\n    </tr>\n    <tr>\n      <th>Background, on an image with no consolidation</th>\n      <td>109</td>\n      <td>20</td>\n    </tr>\n    <tr>\n      <th>Correct</th>\n      <td>55</td>\n      <td>42</td>\n    </tr>\n    <tr>\n      <th>Duplicate of a found finding</th>\n      <td>20</td>\n      <td>4</td>\n    </tr>\n    <tr>\n      <th>Nested inside a higher-scoring box</th>\n      <td>150</td>\n      <td>21</td>\n    </tr>\n    <tr>\n      <th>Poor localisation (0.1 ≤ IoU &lt; 0.5)</th>\n      <td>42</td>\n      <td>14</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x450 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":32},{"cell_type":"code","source":"import torch\nimport torch.nn.functional as F\nimport torchvision.models.detection.roi_heads as roi_heads_module\n\nFOCAL_GAMMA = 2.0   # standard value from Lin et al. (2017)\n_original_fastrcnn_loss = roi_heads_module.fastrcnn_loss\n\n\ndef focal_fastrcnn_loss(class_logits, box_regression, labels, regression_targets):\n    \"\"\"torchvision's fastrcnn_loss, with the classification term replaced by Focal Loss.\"\"\"\n    labels = torch.cat(labels, dim=0)\n    regression_targets = torch.cat(regression_targets, dim=0)\n\n    # --- Focal Loss: down-weight easy examples, focus on hard ones ---\n    ce = F.cross_entropy(class_logits, labels, reduction=\"none\")\n    p_t = torch.exp(-ce)                           # probability given to the correct class\n    classification_loss = ((1 - p_t) ** FOCAL_GAMMA * ce).mean()\n\n    # --- Box regression: unchanged from torchvision ---\n    sampled_pos_inds_subset = torch.where(labels > 0)[0]\n    labels_pos = labels[sampled_pos_inds_subset]\n    N, num_classes = class_logits.shape\n    box_regression = box_regression.reshape(N, box_regression.size(-1) // 4, 4)\n    box_loss = F.smooth_l1_loss(\n        box_regression[sampled_pos_inds_subset, labels_pos],\n        regression_targets[sampled_pos_inds_subset],\n        beta=1 / 9,\n        reduction=\"sum\",\n    )\n    box_loss = box_loss / labels.numel()\n    return classification_loss, box_loss\n\n\n# Free GPU memory from earlier models (they stay available on the CPU)\nfor m in (\"model\", \"model_base\"):\n    if m in globals():\n        globals()[m].to(\"cpu\")\ntorch.cuda.empty_cache()\n\n# Same anchors, seed, epochs, optimiser and schedule as the anchor model; only the loss differs\nset_seed(42)\nmodel_focal = build_model(PROPOSED_SIZES, PROPOSED_RATIOS)\n\nroi_heads_module.fastrcnn_loss = focal_fastrcnn_loss\ntry:\n    model_focal, loss_focal = train_detector(model_focal, EXP_EPOCHS, f\"frcnn_anchors_focal_{EXP_EPOCHS}ep\")\nfinally:\n    roi_heads_module.fastrcnn_loss = _original_fastrcnn_loss   # always restore the original\nprint(\"Original loss restored:\", roi_heads_module.fastrcnn_loss is _original_fastrcnn_loss)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T16:22:26.955096Z","iopub.execute_input":"2026-10-11T16:22:26.955663Z","iopub.status.idle":"2026-10-11T16:40:38.89101Z","shell.execute_reply.started":"2026-10-11T16:22:26.955637Z","shell.execute_reply":"2026-10-11T16:40:38.890184Z"}},"outputs":[{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.0439] \n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_focal_5ep] epoch 1/5: loss 0.2236, lr 5.00e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.0203] \n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_focal_5ep] epoch 2/5: loss 0.1762, lr 4.53e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:37<00:00,  1.11it/s, loss=0.0243]  \n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_focal_5ep] epoch 3/5: loss 0.1615, lr 3.31e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.0132] \n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_focal_5ep] epoch 4/5: loss 0.1310, lr 1.79e-05\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 242/242 [03:38<00:00,  1.11it/s, loss=0.000886]\n","output_type":"stream"},{"name":"stdout","text":"[frcnn_anchors_focal_5ep] epoch 5/5: loss 0.1097, lr 5.68e-06\nOriginal loss restored: True\n","output_type":"stream"}],"execution_count":33},{"cell_type":"code","source":"import os, torch\n\nFOCAL_W = f\"{OUT_DIR}/frcnn_anchors_focal_{EXP_EPOCHS}ep.pth\"\n\nif \"train_focal\" not in globals() or \"test_focal\" not in globals():\n    if \"model_focal\" not in globals():\n        assert os.path.exists(FOCAL_W), f\"{FOCAL_W} not found, run the Focal training cell first\"\n        model_focal = build_model(PROPOSED_SIZES, PROPOSED_RATIOS)\n        model_focal.load_state_dict(torch.load(FOCAL_W, map_location=device))\n        print(\"Loaded saved Focal model:\", FOCAL_W)\n    model_focal.to(device)\n    test_focal  = collect_predictions(model_focal, test_set)\n    train_focal = collect_predictions(model_focal, train_set)\n\nplot_train_test_cm(train_focal, test_focal, \"Experiment 2: Anchors + Focal Loss\", cmap=\"Reds\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T16:48:56.493812Z","iopub.execute_input":"2026-10-11T16:48:56.494701Z","iopub.status.idle":"2026-10-11T16:50:49.456889Z","shell.execute_reply.started":"2026-10-11T16:48:56.49467Z","shell.execute_reply":"2026-10-11T16:50:49.456246Z"}},"outputs":[{"name":"stderr","text":"Collecting: 100%|██████████| 32/32 [00:13<00:00,  2.43it/s]\nCollecting: 100%|██████████| 242/242 [01:39<00:00,  2.44it/s]\n","output_type":"stream"},{"name":"stdout","text":"Experiment 2: Anchors + Focal Loss [Train] TN=551 FP=130 FN=38 TP=246 | Accuracy=0.826 Sensitivity=0.866 Specificity=0.809 Precision=0.654\nExperiment 2: Anchors + Focal Loss [Test] TN=63 FP=20 FN=7 TP=35 | Accuracy=0.784 Sensitivity=0.833 Specificity=0.759 Precision=0.636\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":35},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nmodel_base.to(device)   # needed again for the comparison\n\n# ---- Official evaluation (same as Step 5) ----\nPRED_FOCAL = f\"{OUT_DIR}/pred_json_anchors_focal_{EXP_EPOCHS}ep\"\nwrite_predictions(model_focal, PRED_FOCAL)\nprint(\"\\n##### Data-driven anchors + Focal Loss #####\")\nevaluate_official(PRED_FOCAL)\n\n# ---- Full comparison ----\ntest_focal = collect_predictions(model_focal, test_set)\ntrain_focal = collect_predictions(model_focal, train_set)\n\ncomparison3 = pd.DataFrame({\n    \"Baseline (test)\": summarise(*test_base),\n    \"Anchors (test)\": summarise(*test_anchor),\n    \"Anchors + Focal (test)\": summarise(*test_focal),\n})\ncomparison3[\"Change vs Anchors (test)\"] = comparison3[\"Anchors + Focal (test)\"] - comparison3[\"Anchors (test)\"]\ncomparison3[\"Anchors (train)\"] = pd.Series(summarise(*train_anchor))\ncomparison3[\"Anchors + Focal (train)\"] = pd.Series(summarise(*train_focal))\nprint(\"\\nComparison (IoU ≥ 0.5):\")\ndisplay(comparison3.round(4))\n\n# ---- Error breakdown for the new model ----\nerr_focal = classify_errors(*test_focal, test_set)\nbreakdown = pd.DataFrame({\n    \"Anchors (≥0.5)\": err_anchor[err_anchor[\"score\"] >= 0.5][\"category\"].value_counts(),\n    \"Anchors + Focal (≥0.5)\": err_focal[err_focal[\"score\"] >= 0.5][\"category\"].value_counts(),\n}).fillna(0).astype(int)\nprint(\"\\nConfident boxes (≥0.5) by type:\")\ndisplay(breakdown)\n\n# ---- Visuals ----\nfig, ax = plt.subplots(1, 3, figsize=(20, 5))\n\nfor name, (preds, gts), color in [(\"Baseline\", test_base, \"tab:blue\"),\n                                  (\"Data-driven anchors\", test_anchor, \"tab:green\"),\n                                  (\"Anchors + Focal Loss\", test_focal, \"tab:red\")]:\n    _, sens, fpi, prec = FROC(preds, gts, iou_th=0.5)\n    ax[0].plot(fpi, sens, label=name, color=color)\n    ax[1].plot(sens, prec, label=name, color=color)\nfor fp in [0.05, 0.1, 0.2, 0.5]:\n    ax[0].axvline(fp, linestyle=\"--\", color=\"grey\", alpha=0.4)\nax[0].set_xlim(0, 2); ax[0].set_ylim(0, 1)\nax[0].set_xlabel(\"Average false positives per image\"); ax[0].set_ylabel(\"Recall\")\nax[0].set_title(\"FROC curve (test set)\"); ax[0].legend()\nax[1].set_xlim(0, 1); ax[1].set_ylim(0, 1)\nax[1].set_xlabel(\"Recall\"); ax[1].set_ylabel(\"Precision\")\nax[1].set_title(\"Box-level precision-recall (test set)\"); ax[1].legend()\n\n# Highest box score per image: images with vs without consolidation\nfor name, (preds, gts), style in [(\"Anchors\", test_anchor, \"--\"), (\"Anchors + Focal\", test_focal, \"-\")]:\n    top = np.array([p[:, 4].max() if len(p) else 0.0 for p in preds])\n    has = np.array([len(g) > 0 for g in gts])\n    ax[2].hist(top[has], bins=20, range=(0, 1), histtype=\"step\", linestyle=style, color=\"green\",\n               linewidth=2, label=f\"{name}: images WITH consolidation\")\n    ax[2].hist(top[~has], bins=20, range=(0, 1), histtype=\"step\", linestyle=style, color=\"red\",\n               linewidth=2, label=f\"{name}: images WITHOUT consolidation\")\nax[2].set_xlabel(\"Highest box score in the image\"); ax[2].set_ylabel(\"Number of images\")\nax[2].set_title(\"Separation of positive vs negative X-rays\"); ax[2].legend(fontsize=7)\n\nplt.tight_layout()\nplt.show()\n\ncompare_predictions({\"Baseline\": model_base, \"Anchors\": model_anchor, \"Anchors + Focal\": model_focal},\n                    test_set, [\"40424.png\", \"41225.png\", \"62137.png\", \"45701.png\"])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T16:52:03.54207Z","iopub.execute_input":"2026-10-11T16:52:03.542739Z","iopub.status.idle":"2026-10-11T16:54:14.249733Z","shell.execute_reply.started":"2026-10-11T16:52:03.54271Z","shell.execute_reply":"2026-10-11T16:54:14.248401Z"}},"outputs":[{"name":"stderr","text":"Predicting -> pred_json_anchors_focal_5ep: 100%|██████████| 32/32 [00:12<00:00,  2.48it/s]\n","output_type":"stream"},{"name":"stdout","text":"\n##### Data-driven anchors + Focal Loss #####\n==================== Recall & Precision ====================\nRecall@0.05=23.61%, Precision@0.05=73.14%\nRecall@0.10=33.33%, Precision@0.10=65.77%\nRecall@0.20=44.44%, Precision@0.20=56.14%\nRecall@0.50=61.11%, Precision@0.50=41.32%\n","output_type":"stream"},{"name":"stderr","text":"Collecting: 100%|██████████| 32/32 [00:13<00:00,  2.36it/s]\nCollecting: 100%|██████████| 242/242 [01:39<00:00,  2.43it/s]\n","output_type":"stream"},{"name":"stdout","text":"\nComparison (IoU ≥ 0.5):\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                           Baseline (test)  Anchors (test)  \\\nRecall@0.05                         0.2917          0.2083   \nPrecision@0.05        