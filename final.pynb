   <td>599.0000</td>\n      <td>392.0000</td>\n      <td>2509.0000</td>\n      <td>2117.0000</td>\n      <td>2635.0000</td>\n      <td>18920.0000</td>\n    </tr>\n    <tr>\n      <th>Predicted boxes per image</th>\n      <td>4.7920</td>\n      <td>3.1360</td>\n      <td>20.0720</td>\n      <td>16.9360</td>\n      <td>2.7306</td>\n      <td>19.6062</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\nConfident boxes (≥0.5) by type:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                                               Anchors (≥0.5)  \\\ncategory                                                        \nBackground, on an image with consolidation                  4   \nBackground, on an image with no consolidation              20   \nCorrect                                                    42   \nDuplicate of a found finding                                4   \nNested inside a higher-scoring box                         21   \nPoor localisation (0.1 ≤ IoU < 0.5)                        14   \n\n                                               Anchors + Focal (≥0.5)  \ncategory                                                               \nBackground, on an image with consolidation                          6  \nBackground, on an image with no consolidation                      25  \nCorrect                                                            44  \nDuplicate of a found finding                                        8  \nNested inside a higher-scoring box                                 18  \nPoor localisation (0.1 ≤ IoU < 0.5)                                16  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Anchors (≥0.5)</th>\n      <th>Anchors + Focal (≥0.5)</th>\n    </tr>\n    <tr>\n      <th>category</th>\n      <th></th>\n      <th></th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Background, on an image with consolidation</th>\n      <td>4</td>\n      <td>6</td>\n    </tr>\n    <tr>\n      <th>Background, on an image with no consolidation</th>\n      <td>20</td>\n      <td>25</td>\n    </tr>\n    <tr>\n      <th>Correct</th>\n      <td>42</td>\n      <td>44</td>\n    </tr>\n    <tr>\n      <th>Duplicate of a found finding</th>\n      <td>4</td>\n      <td>8</td>\n    </tr>\n    <tr>\n      <th>Nested inside a higher-scoring box</th>\n      <td>21</td>\n      <td>18</td>\n    </tr>\n    <tr>\n      <th>Poor localisation (0.1 ≤ IoU &lt; 0.5)</th>\n      <td>14</td>\n      <td>16</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x500 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x1600 with 16 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":36},{"cell_type":"code","source":"import pandas as pd\n\nruns = {\n    \"Baseline\":         {\"Train\": train_base,   \"Test\": test_base,   \"color\": \"tab:blue\",  \"cmap\": \"Blues\"},\n    \"Exp 1: Anchors\":   {\"Train\": train_anchor, \"Test\": test_anchor, \"color\": \"tab:green\", \"cmap\": \"Greens\"},\n    \"Exp 2: + Focal\":   {\"Train\": train_focal,  \"Test\": test_focal,  \"color\": \"tab:red\",   \"cmap\": \"Reds\"},\n}\n\n# ---- Figure 1: 3x2 grid of confusion matrices ----\nfig, axes = plt.subplots(3, 2, figsize=(11, 14))\nfor r, (name, d) in enumerate(runs.items()):\n    for c, split in enumerate([\"Train\", \"Test\"]):\n        cm, s = image_cm(*d[split])\n        ax = axes[r, c]\n        sns.heatmap(cm, annot=True, fmt=\"d\", cmap=d[\"cmap\"], cbar=False, ax=ax,\n                    xticklabels=LABELS, yticklabels=LABELS)\n        ax.set_title(f\"{name}, {split}\\nAcc {s['Accuracy']:.3f} | Sens {s['Sensitivity']:.3f} | Spec {s['Specificity']:.3f}\",\n                     fontsize=10)\n        ax.set_xlabel(\"Predicted\"); ax.set_ylabel(\"Actual\")\nplt.suptitle(\"Image-level confusion matrices: Baseline vs Experiments\", fontsize=13)\nplt.tight_layout(); plt.show()\n\n# ---- Summary table ----\nrows = {}\nfor name, d in runs.items():\n    _, s_tr = image_cm(*d[\"Train\"]); _, s_te = image_cm(*d[\"Test\"])\n    det = summarise(*d[\"Test\"])\n    rows[name] = {\"Train acc\": s_tr[\"Accuracy\"], \"Test acc\": s_te[\"Accuracy\"],\n                  \"Gap\": s_tr[\"Accuracy\"] - s_te[\"Accuracy\"],\n                  \"Test sens\": s_te[\"Sensitivity\"], \"Test spec\": s_te[\"Specificity\"],\n                  \"Test precision\": s_te[\"Precision\"],\n                  \"Recall@0.5 FP\": det[\"Recall@0.5\"], \"Max recall\": det[\"Max recall\"],\n                  \"Boxes/img\": det[\"Predicted boxes per image\"]}\nsummary = pd.DataFrame(rows).T\ndisplay(summary.round(3))\n\n# ---- Figure 2: three-panel comparison ----\nfig, axes = plt.subplots(1, 3, figsize=(20, 5.5))\nnames = list(runs.keys()); colors = [runs[n][\"color\"] for n in names]\n\n# (a) test metrics, grouped bars\nmetrics = [\"Test acc\", \"Test sens\", \"Test spec\", \"Test precision\", \"Recall@0.5 FP\"]\nx = np.arange(len(metrics)); w = 0.26\nfor i, n in enumerate(names):\n    vals = summary.loc[n, metrics].astype(float).values\n    bars = axes[0].bar(x + (i - 1) * w, vals, w, label=n, color=colors[i])\n    axes[0].bar_label(bars, fmt=\"%.2f\", fontsize=8)\naxes[0].set_xticks(x); axes[0].set_xticklabels(metrics, rotation=15)\naxes[0].set_ylim(0, 1.1); axes[0].set_title(\"Test-set metrics\"); axes[0].legend()\n\n# (b) train vs test accuracy\nx2 = np.arange(len(names))\nb1 = axes[1].bar(x2 - 0.18, summary[\"Train acc\"].astype(float), 0.36, label=\"Train\", color=\"lightgray\", edgecolor=\"k\")\nb2 = axes[1].bar(x2 + 0.18, summary[\"Test acc\"].astype(float), 0.36, label=\"Test\", color=colors, edgecolor=\"k\")\naxes[1].bar_label(b1, fmt=\"%.3f\", fontsize=8); axes[1].bar_label(b2, fmt=\"%.3f\", fontsize=8)\naxes[1].set_xticks(x2); axes[1].set_xticklabels(names)\naxes[1].set_ylim(0, 1.1); axes[1].set_title(\"Image-level accuracy: train vs test\"); axes[1].legend()\n\n# (c) FROC curves on the test set\nfor n in names:\n    _, sens, fpi, _ = FROC(*runs[n][\"Test\"], iou_th=0.5)\n    axes[2].plot(fpi, sens, label=n, color=runs[n][\"color\"], lw=2)\nfor fp in (0.05, 0.1, 0.2, 0.5):\n    axes[2].axvline(fp, ls=\":\", color=\"gray\", lw=0.8)\naxes[2].set_xscale(\"log\"); axes[2].set_xlim(0.01, 10)\naxes[2].set_xlabel(\"False positives per image (log)\"); axes[2].set_ylabel(\"Recall (sensitivity)\")\naxes[2].set_title(\"FROC: test set\"); axes[2].legend(); axes[2].grid(alpha=0.3)\n\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-11T17:19:30.91743Z","iopub.execute_input":"2026-10-11T17:19:30.917709Z","iopub.status.idle":"2026-10-11T17:19:32.664581Z","shell.execute_reply.started":"2026-10-11T17:19:30.917684Z","shell.execute_reply":"2026-10-11T17:19:32.663978Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x1400 with 6 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"                Train acc  Test acc    Gap  Test sens  Test spec  \\\nBaseline            0.852     0.832  0.020      0.762      0.867   \nExp 1: Anchors      0.868     0.792  0.076      0.762      0.807   \nExp 2: + Focal      0.826     0.784  0.042      0.833      0.759   \n\n                Test precision  Recall@0.5 FP  Max recall  Boxes/img  \nBaseline                 0.744          0.583       0.806      4.792  \nExp 1: Anchors           0.667          0.583       0.764      3.136  \nExp 2: + Focal           0.636          0.611       0.889     20.072  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Train acc</th>\n      <th>Test acc</th>\n      <th>Gap</th>\n      <th>Test sens</th>\n      <th>Test spec</th>\n      <th>Test precision</th>\n      <th>Recall@0.5 FP</th>\n      <th>Max recall</th>\n      <th>Boxes/img</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Baseline</th>\n      <td>0.852</td>\n      <td>0.832</td>\n      <td>0.020</td>\n      <td>0.762</td>\n      <td>0.867</td>\n      <td>0.744</td>\n      <td>0.583</td>\n      <td>0.806</td>\n      <td>4.792</td>\n    </tr>\n    <tr>\n      <th>Exp 1: Anchors</th>\n      <td>0.868</td>\n      <td>0.792</td>\n      <td>0.076</td>\n      <td>0.762</td>\n      <td>0.807</td>\n      <td>0.667</td>\n      <td>0.583</td>\n      <td>0.764</td>\n      <td>3.136</td>\n    </tr>\n    <tr>\n      <th>Exp 2: + Focal</th>\n      <td>0.826</td>\n      <td>0.784</td>\n      <td>0.042</td>\n      <td>0.833</td>\n      <td>0.759</td>\n      <td>0.636</td>\n      <td>0.611</td>\n      <td>0.889</td>\n      <td>20.072</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x550 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":37},{"cell_type":"code","source":"import shutil, os\nfrom IPython.display import FileLink\n\nos.chdir(\"/kaggle/working\")\n# Leave out chestxdet10: it is just symlinks to the dataset and would copy all the images\nshutil.make_archive(\"bn5212_outputs\", \"zip\", root_dir=\"/kaggle/working\",\n                    base_dir=\".\", logger=None)\nFileLink(\"bn5212_outputs.zip\")","metadata":{"trusted":true,"execution":{"iopub.status.busy"